# CELL 11: Inference Engine
# ============================================================

class SanskritAssistant:
    """Inference wrapper for the fine-tuned model."""

    def __init__(self, mdl, tok):
        self.model     = mdl
        self.tokenizer = tok
        self.model.eval()

        # Fix: ensure pad_token_id != eos_token_id
        # If they are equal, set pad_token_id to a different token
        # to prevent generation from stopping at the first pad token.
        pad_id = tok.pad_token_id
        eos_id = tok.eos_token_id
        if pad_id == eos_id:
            # Use 0 as pad if vocab allows, otherwise keep same
            pad_id = 0 if tok.vocab_size > 1 else eos_id

        self.gen_config = GenerationConfig(
            max_new_tokens     = 300,
            temperature        = 0.3,
            top_p              = 0.9,
            repetition_penalty = 1.15,
            do_sample          = True,
            pad_token_id       = pad_id,
            eos_token_id       = eos_id,
        )

    @torch.no_grad()
    def ask(
        self,
        instruction   : str,
        input_text    : str  = "",
        verbose       : bool = True,
        max_new_tokens: int  = 300,
    ) -> str:
        """Generate a response."""
        self.gen_config.max_new_tokens = max_new_tokens

        prompt = format_inference_prompt(instruction, input_text)

        if verbose:
            print(f"Instruction : {instruction}")
            if input_text:
                short = input_text.replace("\n", " ")[:80]
                print(f"Input       : {short}")
            print("-" * 50)

        inputs = self.tokenizer(
            prompt,
            return_tensors = "pt",
            truncation     = True,
            max_length     = 400,
        ).to(DEVICE)

        # torch.autocast replaces deprecated torch.cuda.amp.autocast
        if torch.cuda.is_available():
            with torch.autocast(
                device_type="cuda", dtype=torch.float16
            ):
                output_ids = self.model.generate(
                    **inputs,
                    generation_config=self.gen_config,
                )
        else:
            output_ids = self.model.generate(
                **inputs,
                generation_config=self.gen_config,
            )

        prompt_len = inputs["input_ids"].shape[1]
        new_ids    = output_ids[0][prompt_len:]
        response   = self.tokenizer.decode(
            new_ids, skip_special_tokens=True
        ).strip()

        if verbose:
            print(response)
            print()

        return response


