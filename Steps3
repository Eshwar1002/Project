def compare_base_vs_finetuned(asst, cases: List[Dict]):
    """
    Compare base (LoRA disabled) vs fine-tuned (LoRA enabled).

    Fixed: peft 0.10 correct method names are
    disable_adapters() and enable_adapters()
    (not disable_adapter_layers / enable_adapter_layers)
    """
    print("=" * 65)
    print("BEFORE vs AFTER FINE-TUNING")
    print("=" * 65)

    # Check which toggle methods are available
    if asst is not None:
        mdl = asst.model
        can_toggle = (
            hasattr(mdl, "disable_adapters")
            and hasattr(mdl, "enable_adapters")
        )
        use_real = True
    else:
        can_toggle = False
        use_real   = False

    if not use_real:
        print("(Model unavailable — showing documented examples)")

    compare_data: List[Dict] = []

    for ex in cases:
        label = ex["label"]
        inp   = ex.get("input", "")

        print(f"\n{'─'*65}")
        print(f"Example : {label}")
        if inp:
            print(f"Input   : {inp.replace(chr(10), ' ')[:70]}")

        # BASE output
        print("\nBASE MODEL (LoRA disabled):")
        if use_real and can_toggle:
            try:
                asst.model.disable_adapters()
                base_out = asst.ask(
                    ex["instruction"], inp, verbose=False
                )
            except Exception as e:
                base_out = f"[Error: {e}]"
            finally:
                # Always re-enable even if error occurs
                asst.model.enable_adapters()
        elif use_real and not can_toggle:
            base_out = _DOCUMENTED_BASE.get(
                label, "Generic uncertain response."
            )
            print("  (adapter toggle unavailable — showing documented)")
        else:
            base_out = _DOCUMENTED_BASE.get(
                label, "Generic uncertain response."
            )

        for line in base_out.split("\n"):
            print(f"  {line}")

        # FINE-TUNED output
        print("\nFINE-TUNED MODEL (LoRA enabled):")
        if use_real:
            ft_out = asst.ask(
                ex["instruction"], inp, verbose=False
            )
        else:
            ft_out = _DOCUMENTED_FT.get(
                label, "Detailed accurate response."
            )

        for line in ft_out.split("\n"):
            print(f"  {line}")

        # Keyword scores
        kws     = ex.get("keywords", [])
        base_kw = sum(
            1 for k in kws if k.lower() in base_out.lower()
