def analyze_tokenization(text: str, label: str = "") -> Dict:
    """Return tokenization statistics."""
    ids    = tokenizer.encode(text, add_special_tokens=False)
    tokens = [tokenizer.decode([t]) for t in ids]
    n_deva = sum(1 for c in text if "\u0900" <= c <= "\u097F")
    ratio  = len(text) / max(len(ids), 1)
    return {
        "label"   : label,
        "text"    : text,
        "n_chars" : len(text),
        "n_tokens": len(ids),
        "tokens"  : tokens[:20],
        "n_deva"  : n_deva,
        "ratio"   : ratio,
    }


