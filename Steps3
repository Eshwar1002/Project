    """
    global MODEL_LOADED, ASSISTANT_READY, model, tokenizer, assistant

    # Check required files exist
    required = ["adapter_config.json"]
    weight_candidates = [
        "adapter_model.safetensors",
        "adapter_model.bin",
    ]
    missing_cfg = [
        f for f in required
        if not os.path.exists(os.path.join(adapter_path, f))
    ]
    has_weights = any(
        os.path.exists(os.path.join(adapter_path, w))
        for w in weight_candidates
    )

    if missing_cfg or not has_weights:
        print("Adapter not found. Missing files:")
        for f in required + weight_candidates:
            fp     = os.path.join(adapter_path, f)
            status = "FOUND" if os.path.exists(fp) else "MISSING"
            print(f"  [{status}] {f}")
        print("Run Cell 10 (training) first.")
        return None, None

    try:
        print("[1/3] Loading tokenizer ...")
        tok_r = AutoTokenizer.from_pretrained(
            adapter_path, trust_remote_code=True
        )
        tok_r.padding_side = "right"
        if tok_r.pad_token is None:
            tok_r.pad_token    = tok_r.eos_token
            tok_r.pad_token_id = tok_r.eos_token_id
        print("      OK")

        print("[2/3] Loading base model (4-bit) ...")
        # get_bnb_config() defined in Cell 8
        base = AutoModelForCausalLM.from_pretrained(
            base_model_id,
            quantization_config = get_bnb_config(),
            device_map          = "auto",
            token               = hf_token,
            trust_remote_code   = True,
            torch_dtype         = torch.float16,
        )
        print("      OK")

        print("[3/3] Loading LoRA adapter ...")
        mdl_r = PeftModel.from_pretrained(
            base,
            adapter_path,
            is_trainable=False,
        )
        mdl_r.eval()
        print("      OK")

        if torch.cuda.is_available():
