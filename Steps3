def plot_training_curves(tr, out_dir: str):
    """Plot loss and LR curves. Uses mock data if no trainer."""

    train_steps, train_losses = [], []
    eval_steps,  eval_losses  = [], []
    lr_steps,    lr_values    = [], []
    use_mock = True

    if tr is not None and hasattr(tr, "state"):
        for entry in tr.state.log_history:
            step = entry.get("step", 0)
            if "loss" in entry and "eval_loss" not in entry:
                train_steps.append(step)
                train_losses.append(float(entry["loss"]))
            if "eval_loss" in entry:
                eval_steps.append(step)
                eval_losses.append(float(entry["eval_loss"]))
            if "learning_rate" in entry:
                lr_steps.append(step)
                lr_values.append(float(entry["learning_rate"]))
        if train_losses:
            use_mock = False

    if use_mock:
        np.random.seed(42)
        total   = 55
        warmup  = 2
        s       = np.arange(total, dtype=float)
        train_losses = list(
            2.8 * np.exp(-s / 18) + 0.55
            + np.random.normal(0, 0.03, total)
        )
        train_losses = [max(v, 0.45) for v in train_losses]
        train_steps  = list(range(total))
        es           = [0, 10, 20, 30, 40, total - 1]
        eval_losses  = list(
            2.6 * np.exp(-np.array(es, dtype=float) / 18)
            + 0.65 + np.random.normal(0, 0.02, len(es))
        )
        eval_losses  = [max(v, 0.55) for v in eval_losses]
        eval_steps   = es
        lr_values    = list(np.where(
            s < warmup,
            2e-4 * s / warmup,
            2e-4 * 0.5 * (
                1 + np.cos(
                    np.pi * (s - warmup) / (total - warmup)
                )
            )
        ))
        lr_steps = list(range(total))

    fig, axes = plt.subplots(1, 2, figsize=(14, 5))
    suffix = " (Simulated)" if use_mock else ""
    fig.suptitle(
        f"Sanskrit LLM Fine-Tuning — Training Curves{suffix}",
        fontsize=13, fontweight="bold",
    )

    # Loss plot
    ax1 = axes[0]
    ax1.plot(train_steps, train_losses,
             color="#2196F3", lw=2, label="Train Loss")
    if eval_losses:
        ax1.plot(eval_steps, eval_losses,
                 color="#F44336", lw=2, ls="--",
                 marker="o", ms=4, label="Val Loss")
    ax1.set_xlabel("Steps")
    ax1.set_ylabel("Loss")
    ax1.set_title("Loss Curves")
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    ax1.set_ylim(bottom=0)
    info = (
        f"Train: {train_losses[0]:.2f} -> {train_losses[-1]:.2f}"
    )
    if eval_losses:
        info += f"\nVal:   {eval_losses[0]:.2f} -> {eval_losses[-1]:.2f}"
    ax1.text(
        0.58, 0.84, info,
        transform=ax1.transAxes, fontsize=9,
        bbox=dict(boxstyle="round", facecolor="wheat", alpha=0.5),
