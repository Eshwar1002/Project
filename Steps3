def run_training(
    mdl,
    tok,
    train_ds : Dataset,
    val_ds   : Dataset,
    out_dir  : str,
) -> Tuple[Optional[object], Optional[object]]:
    """
    SFT training with completion-only loss masking.
    Returns (trainer, train_result) or (None, None).
    """
    if not MODEL_LOADED or mdl is None:
        print("Model not loaded. Skipping training.")
        return None, None

    args     = get_training_args(out_dir)
    collator = DataCollatorForCompletionOnlyLM(
        response_template = "### Response:\n",
        tokenizer         = tok,
        mlm               = False,
    )

    # trl 0.8.6 accepts tokenizer= kwarg
    trainer_obj = SFTTrainer(
        model              = mdl,
        args               = args,
        train_dataset      = train_ds,
        eval_dataset       = val_ds,
        tokenizer          = tok,
        data_collator      = collator,
        dataset_text_field = "text",
        max_seq_length     = 512,
        packing            = False,
    )

    eff_batch    = (args.per_device_train_batch_size
                    * args.gradient_accumulation_steps)
    steps_per_ep = max(1, len(train_ds) // eff_batch)
    total_steps  = steps_per_ep * int(args.num_train_epochs)

    print(f"Training plan:")
    print(f"  Train examples  : {len(train_ds)}")
    print(f"  Effective batch : {eff_batch}")
    print(f"  Steps/epoch     : {steps_per_ep}")
    print(f"  Total steps     : {total_steps}")

    print("\nPre-training eval ...")
    pre_loss = trainer_obj.evaluate()["eval_loss"]
    print(f"  Pre loss : {pre_loss:.4f}")

    print("\nTraining ...")
    t0         = time.time()
    train_res  = trainer_obj.train()
    elapsed    = time.time() - t0
    train_loss = train_res.training_loss

    print(f"\nDone in {elapsed/60:.1f} min")
    print(f"  Train loss : {train_loss:.4f}")

    print(f"\nSaving to {out_dir} ...")
    trainer_obj.save_model(out_dir)
    tok.save_pretrained(out_dir)
    print("  Saved.")

    post_loss = trainer_obj.evaluate()["eval_loss"]
    print(f"\nEval loss : {pre_loss:.4f} -> {post_loss:.4f} "
          f"(improved {pre_loss - post_loss:.4f})")

    return trainer_obj, train_res


trainer, train_result = run_training(
    model, tokenizer,
