def keyword_score(text: str, keywords: List[str]) -> float:
    """Fraction of keywords found in text (case-insensitive)."""
    if not keywords:
        return 0.0
    t = text.lower()
    return (
        sum(1 for kw in keywords if kw.lower() in t)
        / len(keywords)
    )


def run_evaluation(asst, suite: List[Dict]) -> Dict:
    """
    Keyword evaluation.
    Always returns a valid dict even if assistant is None.
    """
    results: List[Dict] = []

    if asst is None:
        print("Assistant unavailable. Using mock scores.")
        mock = {
            "san2eng"      : 0.82,
            "eng2san"      : 0.58,
            "grammar"      : 0.77,
            "qa"           : 0.81,
            "explanation"  : 0.73,
            "generalization": 0.55,
        }
        for ex in suite:
            results.append({
                "label"    : ex["label"],
                "task"     : ex["task"],
                "generated": "[model not loaded]",
                "kw_score" : mock.get(ex["task"], 0.65),
                "keywords" : ex.get("keywords", []),
            })
    else:
        print("Running evaluation ...")
        print("-" * 55)
        for ex in suite:
            try:
                resp = asst.ask(
                    ex["instruction"],
                    ex.get("input", ""),
                    verbose=False,
                )
            except Exception as e:
                print(f"  ERROR {ex['label']}: {e}")
                resp = ""
            score  = keyword_score(resp, ex.get("keywords", []))
            status = "PASS" if score >= 0.5 else "WEAK"
            print(f"  [{status}] {ex['label']:<30} kw={score:.2f}")
            results.append({
                "label"    : ex["label"],
                "task"     : ex["task"],
                "generated": resp,
                "kw_score" : score,
                "keywords" : ex.get("keywords", []),
            })

    overall   = float(np.mean([r["kw_score"] for r in results]))
    by_task_raw: Dict[str, List[float]] = {}
    for r in results:
        by_task_raw.setdefault(r["task"], []).append(r["kw_score"])
    by_task   = {
        t: float(np.mean(s)) for t, s in by_task_raw.items()
    }
    pass_rate = float(
        sum(1 for r in results if r["kw_score"] >= 0.5)
        / max(len(results), 1)
    )

    print(f"\nOverall   : {overall:.3f}")
    print(f"Pass rate : {pass_rate:.1%}")
    print("\nBy task:")
    for t, s in sorted(by_task.items()):
        print(f"  {t:<22} {s:.3f}")

    return {
        "overall"  : overall,
        "by_task"  : by_task,
        "results"  : results,
        "pass_rate": pass_rate,
    }


eval_results = run_evaluation(
