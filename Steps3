from datasets import load_dataset

def load_external_data(max_samples: int = 150) -> List[Dict]:
    """
    Load Sanskrit/Hindi parallel data from OPUS.
    Returns empty list gracefully if all sources fail.
    """
    examples: List[Dict] = []

    instruction_pool = [
        "Translate the following Sanskrit text to English.",
        "What is the English translation of this Sanskrit text?",
        "Convert this Sanskrit text to English.",
        "Provide an English translation of the following.",
    ]

    sources = [
        ("Helsinki-NLP/opus-100", "en-sa", "sa", "en"),
        ("Helsinki-NLP/opus-100", "en-hi", "hi", "en"),
    ]

    for ds_name, config, src_key, tgt_key in sources:
        if len(examples) >= max_samples:
            break
        try:
            print(f"  Trying {config} ...")
            ds = load_dataset(
                ds_name,
                config,
                split            = "train",
                streaming        = True,
                trust_remote_code= True,
            )
            count = 0
            for item in ds:
                if count >= max_samples:
                    break
                trans = item.get("translation", {})
                src   = str(trans.get(src_key, "")).strip()
                tgt   = str(trans.get(tgt_key, "")).strip()
                has_deva = any(
                    "\u0900" <= ch <= "\u097F" for ch in src
                )
                if has_deva and len(src) >= 10 and len(tgt) >= 10:
                    examples.append({
                        "instruction": instruction_pool[
                            count % len(instruction_pool)
                        ],
                        "input" : src,
                        "output": tgt,
                        "task"  : "san2eng",
                    })
                    count += 1

            print(f"  Collected {count} examples")
            if count > 0:
                break

        except Exception as exc:
            print(f"  Failed ({config}): {type(exc).__name__}: {exc}")
            continue

    if not examples:
        print("  All sources failed. Using seed examples only.")

    return examples


