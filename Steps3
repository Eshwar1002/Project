def run_translation_metrics(
    asst,
    pairs: List[Dict],
) -> Dict:
    """
    Compute BLEU, chrF, ROUGE on held-out pairs.

    sacrebleu 2.4.0 API:
      corpus_bleu(hypotheses, list_of_ref_lists)
      corpus_chrf(hypotheses, list_of_ref_lists)
      sentence_bleu(hypothesis, list_of_refs)
    """
    instruction = "Translate the following Sanskrit text to English."

    # Generate predictions
    if asst is not None:
        print("Generating translations ...")
        predictions: List[str] = []
        for pair in pairs:
            pred = asst.ask(
                instruction, pair["sanskrit"], verbose=False
            )
            predictions.append(pred)
            print(f"  {pair['sanskrit'][:28]:<30} -> "
                  f"{pred[:45]}...")
    else:
        predictions = [
            "Knowledge bestows humility and wisdom",
            "May all beings everywhere be happy",
            "Non-violence is the highest duty and dharma",
            "Knowledge is the supreme strength and power",
            "Lead me from darkness to light",
            "Speak the truth and walk in righteousness",
        ]
        print("Using mock predictions (model not loaded).")

    primary_refs = [p["reference"] for p in pairs]

    # Build reference matrix: List[List[str]]
    # Outer list = one entry per reference position
    # Inner list = one entry per hypothesis
    max_refs = max(
        1 + len(p.get("alt_refs", [])) for p in pairs
    )
    ref_matrix: List[List[str]] = []
    for i in range(max_refs):
        col: List[str] = []
        for p in pairs:
            all_r = [p["reference"]] + p.get("alt_refs", [])
            col.append(all_r[i] if i < len(all_r) else all_r[0])
        ref_matrix.append(col)

    # BLEU
    bleu_single = sacrebleu_lib.corpus_bleu(
        predictions, [primary_refs], tokenize="intl"
    )
    bleu_multi  = sacrebleu_lib.corpus_bleu(
        predictions, ref_matrix, tokenize="intl"
    )

    # chrF — sacrebleu 2.x: same signature as corpus_bleu
    chrf_score  = sacrebleu_lib.corpus_chrf(
        predictions, ref_matrix
    )

    # ROUGE
    rscorer = rouge_scorer_lib.RougeScorer(
        ["rouge1", "rouge2", "rougeL"],
        use_stemmer=False,
    )
    r_agg: Dict[str, List[float]] = {
        "rouge1": [], "rouge2": [], "rougeL": []
    }
    for pred, ref in zip(predictions, primary_refs):
        s = rscorer.score(ref, pred)
        for k in r_agg:
            r_agg[k].append(s[k].fmeasure)
    rouge_avg = {k: float(np.mean(v)) for k, v in r_agg.items()}

    # Per-example sentence BLEU
    per_bleu: List[float] = []
    for pred, p in zip(predictions, pairs):
        all_r = [p["reference"]] + p.get("alt_refs", [])
        b = sacrebleu_lib.sentence_bleu(
            pred, all_r, smooth_method="floor"
        )
        per_bleu.append(float(b.score))

    # Report
    print("\n" + "=" * 55)
    print("TRANSLATION METRICS")
    print("=" * 55)
    print(f"  BLEU (1 ref)  : {bleu_single.score:.2f}")
    print(f"  BLEU (multi)  : {bleu_multi.score:.2f}")
    print(f"  chrF++        : {chrf_score.score:.2f}")
    print(f"  ROUGE-1       : {rouge_avg['rouge1']:.3f}")
    print(f"  ROUGE-2       : {rouge_avg['rouge2']:.3f}")
    print(f"  ROUGE-L       : {rouge_avg['rougeL']:.3f}")
    print(f"\nPer-Example BLEU:")
    print(f"  {'Sanskrit':<35} {'BLEU':>6}")
    print(f"  {'─'*35} {'─'*6}")
    for pair, b in zip(pairs, per_bleu):
        print(f"  {pair['sanskrit'][:33]:<35} {b:>6.1f}")

    print("""
Note: Sanskrit BLEU is lower than European language BLEU because
many valid English translations exist per verse. chrF++ is
more reliable for morphologically rich languages like Sanskrit.
""")

    return {
        "bleu_single": float(bleu_single.score),
        "bleu_multi" : float(bleu_multi.score),
        "chrf"       : float(chrf_score.score),
        "rouge1"     : rouge_avg["rouge1"],
        "rouge2"     : rouge_avg["rouge2"],
        "rougeL"     : rouge_avg["rougeL"],
    }


