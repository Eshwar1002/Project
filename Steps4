def compute_metrics(predictions: list, references: list) -> dict:
    """Compute BLEU-1,2,4 and ROUGE-L for a list of predictions."""
    # BLEU (SacreBLEU expects list of strings and list of lists)
    bleu_result = bleu_metric.compute(
        predictions = predictions,
        references  = [[r] for r in references],
    )

    # ROUGE
    rouge_result = rouge_metric.compute(
        predictions = predictions,
        references  = references,
    )

    return {
        "bleu"    : round(bleu_result["score"], 2),
        "rouge1"  : round(rouge_result["rouge1"], 4),
        "rouge2"  : round(rouge_result["rouge2"], 4),
        "rougeL"  : round(rouge_result["rougeL"], 4),
    }

