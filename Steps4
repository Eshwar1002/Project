        print(f"  Evaluated {i+1}/{n_test_eval} examples...")

print(f"\n✅ Evaluated {len(test_preds)} test examples")

# ── Overall Metrics ─────────────────────────────────────────
if test_preds:
    overall = compute_metrics(test_preds, test_refs)
    print(f"\nOverall Test Metrics ({len(test_preds)} examples):")
    print(f"  BLEU   : {overall['bleu']:.2f}")
    print(f"  ROUGE-1: {overall['rouge1']:.4f}")
    print(f"  ROUGE-2: {overall['rouge2']:.4f}")
