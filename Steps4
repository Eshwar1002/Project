        ("Provide an accurate English rendering of this Sanskrit passage: '{}'", ""),
        ("Convert this Sanskrit text to English: {}", ""),
        ("Translate from Sanskrit to English: {}", ""),
    ]

    EN_SA_TEMPLATES = [
        ("Translate the following English text into Sanskrit.", "{}"),
        ("How do you say '{}' in Sanskrit?", ""),
        ("Write the Sanskrit equivalent of: {}", ""),
        ("Convert this English phrase to Sanskrit: {}", ""),
    ]

    EXPLANATION_TEMPLATES = [
        ("Explain the meaning and significance of the following Sanskrit verse.", "{}"),
        ("What does the Sanskrit verse '{}' mean?", ""),
        ("Provide a detailed explanation of the Sanskrit text: '{}'", ""),
    ]

    def __init__(self):
        self.all_examples = []

    def build_tier1(self):
        """Use hand-crafted expert examples directly."""
        count = len(self.EXPERT_EXAMPLES)
        self.all_examples.extend(self.EXPERT_EXAMPLES)
        print(f"   Tier-1 (expert)      : {count} examples")
        return count

    def build_tier2_public(self):
        """
        Attempt to load a small subset from public HF datasets.
        Falls back gracefully if unavailable in the current environment.
        """
        added = 0

        # ── Try IIT-Bombay Sanskrit-English corpus ──────────
        try:
            ds = load_dataset(
                "ai4bharat/sangraha",
                "filtered_sanskrit",
                split="train",
                streaming=True,
                trust_remote_code=True,
            )
            for i, row in enumerate(ds):
                if i >= 30:
                    break
                text = row.get("text", "").strip()
                if len(text) > 20:
                    self.all_examples.append({
                        "task": "completion",
                        "instruction": "Complete or continue the following Sanskrit text passage.",
                        "input": text[:200],
                        "output": text[200:400] if len(text) > 200 else text,
                    })
                    added += 1
        except Exception as e:
            print(f"   ⚠️  Sangraha dataset unavailable: {e}")

        # ── Try opus100 en-sa (translation pairs) ───────────
        try:
            ds = load_dataset(
                "opus100",
                "en-sa",
                split="train",
                streaming=True,
                trust_remote_code=True,
            )
            for i, row in enumerate(ds):
                if i >= 50:
                    break
                pair = row.get("translation", {})
                en = pair.get("en", "").strip()
                sa = pair.get("sa", "").strip()
                if en and sa and len(en) > 5 and len(sa) > 5:
                    # SA → EN
                    self.all_examples.append({
                        "task": "translation_sa_en",
                        "instruction": "Translate the following Sanskrit text into English.",
                        "input": sa,
                        "output": en,
                    })
                    # EN → SA
                    self.all_examples.append({
                        "task": "translation_en_sa",
                        "instruction": "Translate the following English text into Sanskrit.",
                        "input": en,
                        "output": sa,
                    })
                    added += 2
        except Exception as e:
            print(f"   ⚠️  OPUS100 en-sa unavailable: {e}")

        print(f"   Tier-2 (public HF)   : {added} examples")
        return added

    def build_tier3_synthetic(self):
        """
        Templated augmentation:
        • Paraphrase instructions for existing examples
        • Create new pairs from a curated vocabulary list
        """
        added_before = len(self.all_examples)

        # ── Vocabulary Q&A pairs ────────────────────────────
        vocab = [
            ("पुस्तकम्", "book (neuter)", "pustakam"),
            ("विद्यालयः", "school (masculine)", "vidyālayaḥ"),
            ("आचार्यः", "teacher/guru (masculine)", "ācāryaḥ"),
            ("शिष्यः", "student/disciple (masculine)", "śiṣyaḥ"),
            ("ग्रामः", "village (masculine)", "grāmaḥ"),
            ("नगरम्", "city (neuter)", "nagaram"),
            ("वृक्षः", "tree (masculine)", "vṛkṣaḥ"),
            ("नदी", "river (feminine)", "nadī"),
            ("आकाशः", "sky (masculine)", "ākāśaḥ"),
            ("पृथ्वी", "earth (feminine)", "pṛthvī"),
            ("अग्निः", "fire (masculine)", "agniḥ"),
            ("वायुः", "wind/air (masculine)", "vāyuḥ"),
            ("पर्वतः", "mountain (masculine)", "parvataḥ"),
            ("समुद्रः", "ocean (masculine)", "samudraḥ"),
            ("चन्द्रः", "moon (masculine)", "candraḥ"),
            ("सूर्यः", "sun (masculine)", "sūryaḥ"),
            ("तारा", "star (feminine)", "tārā"),
            ("राजा", "king (masculine)", "rājā"),
            ("रानी", "queen (feminine)", "rānī"),
            ("सेना", "army (feminine)", "senā"),
        ]

        for sa, en_meaning, roman in vocab:
            self.all_examples.append({
                "task": "vocabulary",
                "instruction": "What is the English meaning of the Sanskrit word?",
                "input": sa,
                "output": f"The Sanskrit word {sa} ({roman}) means {en_meaning}.",
            })
            self.all_examples.append({
                "task": "vocabulary",
                "instruction": "Write the Sanskrit word for the following English term.",
                "input": en_meaning.split(" (")[0],
                "output": f"The Sanskrit word for '{en_meaning.split(' (')[0]}' is {sa} ({roman}).",
            })

        # ── Numbers ─────────────────────────────────────────
        numbers = [
            (1, "एकम्", "ekam"), (2, "द्वे", "dve"), (3, "त्रीणि", "trīṇi"),
            (4, "चत्वारि", "catvāri"), (5, "पञ्च", "pañca"),
            (6, "षट्", "ṣaṭ"), (7, "सप्त", "sapta"), (8, "अष्ट", "aṣṭa"),
            (9, "नव", "nava"), (10, "दश", "daśa"),
            (20, "विंशतिः", "viṃśatiḥ"), (100, "शतम्", "śatam"),
        ]
        for n, sa, roman in numbers:
            self.all_examples.append({
                "task": "translation_en_sa",
                "instruction": "Translate the following number into Sanskrit.",
                "input": str(n),
                "output": f"{n} in Sanskrit is {sa} ({roman}).",
            })

        # ── Common verbs ─────────────────────────────────────
        verbs = [
            ("gacchati", "goes/walks", "गच्छति", "√gam"),
            ("paṭhati", "reads/studies", "पठति", "√paṭh"),
            ("vadati", "speaks/says", "वदति", "√vad"),
            ("khādati", "eats", "खादति", "√khād"),
            ("likhati", "writes", "लिखति", "√likh"),
            ("śṛṇoti", "hears/listens", "शृणोति", "√śru"),
            ("paśyati", "sees/looks", "पश्यति", "√dṛś"),
            ("āgacchati", "comes", "आगच्छति", "√ā+gam"),
            ("tiṣṭhati", "stands", "तिष्ठति", "√sthā"),
            ("āste", "sits", "आस्ते", "√ās"),
        ]
        for roman, meaning, deva, root in verbs:
            self.all_examples.append({
                "task": "grammar",
                "instruction": "What is the meaning and root of the Sanskrit verb form?",
                "input": f"{deva} ({roman})",
                "output": (
                    f"The Sanskrit verb {deva} ({roman}) means 'he/she {meaning}'. "
                    f"It is derived from the root {root} and is in the present tense, "
                    f"third person singular, parasmaipada (active voice)."
                ),
            })

        added = len(self.all_examples) - added_before
        print(f"   Tier-3 (synthetic)   : {added} examples")
        return added

    def format_as_prompt(self, example: dict) -> str:
        """
        Format an example into the Alpaca instruction-input-output template.
        This template is widely understood by instruction-tuned LLMs.
        """
        instruction = example["instruction"]
        inp         = example.get("input", "").strip()
        output      = example["output"].strip()

        if inp:
            prompt = (
                f"### Instruction:\n{instruction}\n\n"
                f"### Input:\n{inp}\n\n"
                f"### Response:\n{output}"
            )
        else:
            prompt = (
                f"### Instruction:\n{instruction}\n\n"
                f"### Response:\n{output}"
            )
        return prompt

    def build(self):
        print("\n🔨 Building Sanskrit Instruction Dataset")
        print("-" * 45)

        self.build_tier1()
        self.build_tier2_public()
        self.build_tier3_synthetic()

        print(f"\n   Total raw examples   : {len(self.all_examples)}")

        # Shuffle
        random.shuffle(self.all_examples)

        # Convert to HF Dataset
        formatted = [self.format_as_prompt(ex) for ex in self.all_examples]
        hf_ds = HFDataset.from_dict({
            "text": formatted,
            "task": [ex["task"] for ex in self.all_examples],
            "instruction": [ex["instruction"] for ex in self.all_examples],
            "input": [ex.get("input", "") for ex in self.all_examples],
            "output": [ex["output"] for ex in self.all_examples],
        })

        # Train / Val / Test split
        n = len(hf_ds)
        n_train = int(n * CFG.TRAIN_RATIO)
        n_val   = int(n * CFG.VAL_RATIO)

        splits = hf_ds.train_test_split(
            test_size=(n_val + n - n_train) / n,
            seed=SEED,
        )
        val_test = splits["test"].train_test_split(
            test_size=CFG.TEST_RATIO / (CFG.VAL_RATIO + CFG.TEST_RATIO),
            seed=SEED,
        )

        dataset_dict = DatasetDict({
            "train": splits["train"],
            "validation": val_test["train"],
            "test": val_test["test"],
        })

        print(f"\n   Train set size       : {len(dataset_dict['train'])}")
        print(f"   Validation set size  : {len(dataset_dict['validation'])}")
        print(f"   Test set size        : {len(dataset_dict['test'])}")
        print("\n✅ Dataset built successfully\n")

        # Save to disk
        dataset_dict.save_to_disk(os.path.join(CFG.DATA_DIR, "sanskrit_dataset"))
        print(f"✅ Dataset saved to {CFG.DATA_DIR}/sanskrit_dataset")

        return dataset_dict, self.all_examples


# ── Build the dataset ──────────────────────────────────────
builder = SanskritDatasetBuilder()
dataset_dict, raw_examples = builder.build()
