## Cell 6: LoRA-Enhanced Model Wrapper

```python
# ════════════════════════════════════════════════════════════
# LORA-ENHANCED SENTENCE TRANSFORMER
# Wraps SentenceTransformer with LoRA adapters for
# parameter-efficient fine-tuning.
#
# Benefits:
#   • Trains only ~1–2% of parameters  (saves VRAM)
#   • Supports larger base models on T4
#   • Faster convergence on small datasets
#   • Easy to merge/swap adapters
# ════════════════════════════════════════════════════════════

class LoRASentenceTransformer:
    """
    SentenceTransformer with LoRA (Low-Rank Adaptation).

    Architecture:
        Base model (frozen) + LoRA adapters (trainable)
        Trainable params ≈ 2 × r × d_model × n_adapter_layers

    For multilingual-e5-small (384-dim, 12 layers):
        r=16, target=[query, value], 12 layers
        Trainable ≈ 2 × 16 × 384 × 2 × 12 ≈ 295,000 params
        vs 117M total  ≈  0.25% trainable
    """

    def __init__(self, cfg: Config):
        self.cfg         = cfg
        self.base_model  = None
        self.lora_model  = None
        self.tokenizer   = None

    def build(self) -> SentenceTransformer:
        """
        Build LoRA-wrapped SentenceTransformer.
        Falls back gracefully if LoRA setup fails.
        """
        print(f"⏳ Building LoRA model from: {self.cfg.base_model}")
        base_st = SentenceTransformer(
            self.cfg.base_model, device=DEVICE
        )

        if not self.cfg.use_lora:
            print("ℹ️  LoRA disabled — returning base model")
            return base_st

        try:
            return self._apply_lora(base_st)
        except Exception as e:
            print(f"⚠️  LoRA application failed ({e}) — using base model")
            return base_st

    def _apply_lora(
        self,
        st_model: SentenceTransformer
    ) -> SentenceTransformer:
        """Apply LoRA adapters to the transformer encoder."""
        # Get the underlying HF transformer module
        transformer = st_model[0].auto_model

        lora_cfg = LoraConfig(
            r              = self.cfg.lora_r,
            lora_alpha     = self.cfg.lora_alpha,
            target_modules = self.cfg.lora_target_modules,
            lora_dropout   = self.cfg.lora_dropout,
            bias           = "none",
            # No TaskType needed for embedding models
        )

        lora_transformer = get_peft_model(transformer, lora_cfg)
        lora_transformer.print_trainable_parameters()

        # Swap back into SentenceTransformer
        st_model[0].auto_model = lora_transformer

        total_params     = sum(
            p.numel() for p in st_model.parameters()
        )
        trainable_params = sum(
            p.numel() for p in st_model.parameters()
            if p.requires_grad
        )
        print(f"\n✅ LoRA applied successfully!")
        print(f"   Total parameters    : {total_params:,}")
        print(f"   Trainable (LoRA)    : {trainable_params:,}  "
              f"({100*trainable_params/total_params:.2f}%)")

        return st_model

    def save_lora(
        self,
        st_model: SentenceTransformer,
        path: str
    ):
        """Save LoRA adapters separately from the base model."""
        Path(path).mkdir(parents=True, exist_ok=True)
        try:
            lora_t = st_model[0].auto_model
            if hasattr(lora_t, "save_pretrained"):
                lora_t.save_pretrained(path)
                print(f"✅ LoRA adapters saved to: {path}")
            else:
                st_model.save(path)
        except Exception as e:
            print(f"⚠️  LoRA save failed ({e}) — saving full model")
            st_model.save(path)

    def load_lora(
        self,
        base_path: str,
        lora_path: str
    ) -> SentenceTransformer:
        """Load base model + LoRA adapters."""
        base = SentenceTransformer(base_path, device=DEVICE)
        try:
            lora_t = PeftModel.from_pretrained(
                base[0].auto_model, lora_path
            )
            base[0].auto_model = lora_t
            print(f"✅ LoRA adapters loaded from: {lora_path}")
        except Exception as e:
            print(f"⚠️  LoRA load failed ({e}) — using base model")
        return base
