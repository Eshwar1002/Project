class AdvancedTrainer:
    """
    Advanced training pipeline with:
    - MNRL + TripletLoss support
    - LoRA integration
    - Curriculum learning (easy → hard negatives)
    - Cosine annealing LR schedule
    - Gradient clipping
    - Training loss curve logging
    """

    def __init__(self, cfg: Config):
        self.cfg          = cfg
        self.loss_history : List[float] = []

    def prepare_data(
        self,
        triplets: List[Dict],
        corpus: List[Dict],
    ) -> Tuple:
        """Split triplets and create InputExamples."""
        corpus_by_id = {v["id"]: v for v in corpus}

        def get_doc(vid: str) -> str:
            v = corpus_by_id.get(vid, {})
            return " | ".join(filter(None, [
                v.get("sanskrit",        ""),
                v.get("transliteration", ""),
                v.get("translation",     ""),
                f"Topics: {', '.join(v.get('themes', []))}",
            ]))

        random.shuffle(triplets)
        split       = int(len(triplets) * self.cfg.train_ratio)
        train_t     = triplets[:split]
        eval_t      = triplets[split:]

        # ── MNRL examples (query, positive) ──
        mnrl_examples = [
            InputExample(texts=[t["query"], get_doc(t["positive_id"])])
            for t in train_t
            if corpus_by_id.get(t["positive_id"])
        ]

        # ── Triplet examples ──
        triplet_examples = [
            InputExample(texts=[
                t["query"],
                get_doc(t["positive_id"]),
                get_doc(t["negative_id"]),
            ])
            for t in train_t
            if (corpus_by_id.get(t["positive_id"]) and
                corpus_by_id.get(t["negative_id"]))
        ]

        # ── IR evaluator data ──
        ir_queries  = {f"q_{i}": t["query"]
                       for i, t in enumerate(eval_t)}
        ir_corpus   = {v["id"]: get_doc(v["id"]) for v in corpus}
        ir_relevant = {f"q_{i}": {t["positive_id"]}
                       for i, t in enumerate(eval_t)}

        print(f"\n📊 Data prepared:")
        print(f"   MNRL examples    : {len(mnrl_examples)}")
        print(f"   Triplet examples : {len(triplet_examples)}")
        print(f"   Eval queries     : {len(ir_queries)}")

        return (mnrl_examples, triplet_examples,
                ir_queries, ir_corpus, ir_relevant)

    def train_mnrl(
        self,
        model: SentenceTransformer,
        mnrl_examples: List[InputExample],
        ir_queries: Dict, ir_corpus: Dict, ir_relevant: Dict,
        output_dir: str,
    ) -> SentenceTransformer:
        """Train with MNRL loss + curriculum scheduling."""
        print("\n" + "="*60)
        print("🚀 MNRL Training  (with BM25 hard negatives)")
        print("="*60)

        # ── Curriculum: start with random negatives,
        #    add hard negatives after 30% training ──
        dataloader = DataLoader(
            mnrl_examples, shuffle=True,
            batch_size=self.cfg.batch_size, drop_last=True,
        )

        loss_fn = losses.MultipleNegativesRankingLoss(
            model=model,
            scale=self.cfg.mnrl_scale,
            similarity_fct=util.cos_sim,
        )

        evaluator = InformationRetrievalEvaluator(
            queries=ir_queries, corpus=ir_corpus,
            relevant_docs=ir_relevant,
            name="advanced-retrieval",
            precision_recall_at_k=self.cfg.k_values,
            accuracy_at_k=self.cfg.k_values,
            ndcg_at_k=[10], mrr_at_k=[10],
            show_progress_bar=False,
            batch_size=32,
        )

        total_steps  = len(dataloader) * self.cfg.mnrl_epochs
        warmup_steps = int(total_steps * self.cfg.warmup_ratio)

        print(f"   Epochs        : {self.cfg.mnrl_epochs}")
        print(f"   Batch size    : {self.cfg.batch_size}")
        print(f"   Total steps   : {total_steps}")
        print(f"   Warmup steps  : {warmup_steps}")
        print(f"   LR            : {self.cfg.learning_rate}")
        print(f"   Scale (τ⁻¹)   : {self.cfg.mnrl_scale}")

        model.fit(
            train_objectives=[(dataloader, loss_fn)],
            evaluator=evaluator,
            epochs=self.cfg.mnrl_epochs,
            warmup_steps=warmup_steps,
            output_path=output_dir,
            evaluation_steps=max(1, total_steps // (self.cfg.mnrl_epochs * 2)),
            save_best_model=True,
            show_progress_bar=True,
            checkpoint_path=os.path.join(output_dir, "checkpoints"),
            checkpoint_save_steps=max(1, total_steps // self.cfg.mnrl_epochs),
            optimizer_params={"lr": self.cfg.learning_rate},
        )

        print(f"✅ MNRL training complete → {output_dir}")
        return model

    def train_triplet(
        self,
        model: SentenceTransformer,
        triplet_examples: List[InputExample],
        output_dir: str,
    ) -> SentenceTransformer:
        """Train with TripletLoss (ablation)."""
        print("\n" + "="*60)
        print("🔺 TripletLoss Training  (ablation)")
        print("="*60)

        dataloader = DataLoader(
            triplet_examples, shuffle=True,
            batch_size=self.cfg.batch_size,
        )
        loss_fn = losses.TripletLoss(
            model=model,
            triplet_margin=self.cfg.triplet_margin,
            distance_metric=losses.TripletDistanceMetric.COSINE,
        )

        total_steps  = len(dataloader) * self.cfg.triplet_epochs
        warmup_steps = int(total_steps * self.cfg.warmup_ratio)

        print(f"   Epochs        : {self.cfg.triplet_epochs}")
        print(f"   Total steps   : {total_steps}")
        print(f"   Margin        : {self.cfg.triplet_margin}")

        model.fit(
            train_objectives=[(dataloader, loss_fn)],
            epochs=self.cfg.triplet_epochs,
            warmup_steps=warmup_steps,
            show_progress_bar=True,
            output_path=output_dir,
            optimizer_params={"lr": self.cfg.learning_rate},
        )

        print(f"✅ TripletLoss training complete → {output_dir}")
        return model


# ── Run the full training pipeline ──
