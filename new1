    def __init__(self, cfg: Config):
        self.cfg   = cfg
        self.verses: List[Dict] = []

    # ────────────────────────────────────────────────────────
    # Public API
    # ────────────────────────────────────────────────────────
    def build(self) -> List[Dict]:
        """Build the full corpus, trying HF datasets first."""
        print("📚 Building advanced corpus...")

        hf_verses = self._try_load_huggingface()
        core      = self._build_core_corpus()

        if hf_verses:
            combined = self._merge_corpora(core, hf_verses)
        else:
            combined = core

        combined = self._deduplicate(combined)
        combined = self._infer_themes(combined)
        combined = self._quality_filter(combined)

        self.verses = combined
        self._print_stats()
        return combined

    # ────────────────────────────────────────────────────────
    # HuggingFace loader
    # ────────────────────────────────────────────────────────
    def _try_load_huggingface(self) -> List[Dict]:
        """
        Attempt to load from known HuggingFace Bhagavad Gita datasets.
        Returns empty list on failure — the core corpus is the fallback.
        """
        candidates = [
            ("sury1912/bhagavad-gita",       self._parse_sury1912),
            ("Suyash0054/Bhagavad-Gita-GPT-4-Answers",
                                              self._parse_suyash0054),
        ]

        for dataset_name, parser_fn in candidates:
            try:
                print(f"   ⏳ Trying HuggingFace: {dataset_name}")
                from datasets import load_dataset
                ds = load_dataset(dataset_name, trust_remote_code=True)
                verses = parser_fn(ds)
                if verses:
                    print(f"   ✅ Loaded {len(verses)} verses from {dataset_name}")
                    return verses
            except Exception as e:
                print(f"   ⚠️  {dataset_name} unavailable: {str(e)[:60]}")

        print("   ℹ️  No HF dataset loaded — using core corpus only")
        return []

    def _parse_sury1912(self, ds) -> List[Dict]:
        """Parse sury1912/bhagavad-gita schema."""
        verses = []
        split  = ds.get("train", ds[list(ds.keys())[0]])
        for row in split:
            try:
                ch  = int(row.get("chapter_number", row.get("chapter", 0)))
                vn  = int(row.get("verse_number",  row.get("verse",   0)))
                san = row.get("text",        row.get("sanskrit_text", ""))
                eng = row.get("translation", row.get("english_translation", ""))
                if not eng or len(eng) < 30:
                    continue
                verses.append({
                    "id":              f"BG_{ch}_{vn}",
                    "chapter":         ch,
                    "verse":           vn,
                    "sanskrit":        san,
                    "transliteration": self._devanagari_to_iast(san),
                    "translation":     eng,
                    "themes":          [],
                    "keywords":        [],
                    "source":          "huggingface_sury1912",
                })
            except Exception:
                continue
        return verses

    def _parse_suyash0054(self, ds) -> List[Dict]:
        """Parse Suyash0054 GPT-4 Q&A dataset — extract Q&A pairs."""
        pairs = []
        split = ds.get("train", ds[list(ds.keys())[0]])
        for i, row in enumerate(split):
            question = row.get("question", row.get("input", ""))
            answer   = row.get("answer",   row.get("output", ""))
            if not question or not answer:
                continue
            pairs.append({
                "id":              f"QA_{i}",
                "chapter":        -1,
                "verse":          -1,
                "sanskrit":       "",
                "transliteration": question,
                "translation":    answer,
                "themes":         [],
                "keywords":       [],
                "source":         "huggingface_qa",
            })
        return pairs[:200]   # cap at 200 QA pairs

    # ────────────────────────────────────────────────────────
    # Transliteration helper
    # ────────────────────────────────────────────────────────
    def _devanagari_to_iast(self, text: str) -> str:
        """Convert Devanagari to IAST using indic_transliteration."""
        if not text or not INDIC_AVAILABLE:
            return ""
        try:
            return transliterate(text, sanscript.DEVANAGARI, sanscript.IAST)
        except Exception:
            return ""

