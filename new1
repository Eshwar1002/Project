        fig.add_subplot(gs[0, 1]),   # MRR@K
        fig.add_subplot(gs[1, 0]),   # nDCG@K
        fig.add_subplot(gs[1, 1]),   # Two-stage
        fig.add_subplot(gs[2, :]),   # Improvement heatmap
    ]

    # ── Panels 1–3: per-metric bar charts ──
    for ax, metric_name in zip(axes[:3],
                               ["Recall", "MRR", "nDCG"]):
        n     = len(model_names)
        shift = np.linspace(-(n-1)/2, (n-1)/2, n) * width

        for j, (name, metrics) in enumerate(all_metrics.items()):
            vals = [metrics.get(f"{metric_name}@{k}", 0)
                    for k in k_values]
            bars = ax.bar(
                x + shift[j], vals, width,
                label=name, color=colors[name],
                alpha=0.85, edgecolor="black",
                linewidth=0.4,
