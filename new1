## Cell 9: Multi-Label Evaluation

```python
# ════════════════════════════════════════════════════════════
# MULTI-LABEL EVALUATION
# Standard single-relevant-doc evaluation underestimates
# retrieval quality because many queries have multiple valid
# answers (e.g., "What is the soul?" → BG 2:13, 2:17, 2:20).
#
# This cell:
# 1. Constructs multi-label ground truth by theme clustering
# 2. Computes MAP, R-Precision, and multi-label Recall@K
# 3. Compares single-label vs multi-label metrics
# ════════════════════════════════════════════════════════════

class MultiLabelEvaluator:
    """
    Evaluation with multiple valid ground-truth documents per query.

    Ground truth construction:
      For each unique query text, find ALL corpus verses that share
      at least one theme with the originally labeled positive verse.
      These are treated as valid retrieval targets.
    """

    def __init__(
        self,
        model: SentenceTransformer,
        corpus: List[Dict],
        ir_queries: Dict,
        ir_relevant: Dict,
        theme_overlap_threshold: int = 1,
    ):
        self.model      = model
        self.corpus     = corpus
        self.corpus_by_id = {v["id"]: v for v in corpus}
        self.ir_queries = ir_queries
        self.ir_relevant = ir_relevant
        self.threshold  = theme_overlap_threshold

        # Pre-compute multi-label ground truth
        self.ml_relevant = self._build_multilabel_gt()

        # Pre-compute embeddings
        self.corpus_ids   = [v["id"] for v in corpus]
        self.corpus_texts = [self._doc_text(v) for v in corpus]
        self.corpus_emb   = model.encode(
            self.corpus_texts, normalize_embeddings=True,
            show_progress_bar=False, batch_size=32,
        )
        dim        = self.corpus_emb.shape[1]
        self.index = faiss.IndexFlatIP(dim)
        self.index.add(self.corpus_emb.astype(np.float32))

    def _doc_text(self, v: Dict) -> str:
        return " | ".join(filter(None, [
            v.get("transliteration", ""),
            v.get("translation",     ""),
            f"Topics: {', '.join(v.get('themes', []))}",
        ]))

    def _build_multilabel_gt(self) -> Dict[str, Set[str]]:
        """
        Expand single-label ground truth to multi-label.

        For each (qid, positive_id) pair, add all corpus verses
        that share >= threshold themes with the positive verse.
        """
        ml_relevant = {}
        for qid, rel_set in self.ir_relevant.items():
            pos_id    = list(rel_set)[0]
            pos_verse = self.corpus_by_id.get(pos_id, {})
            pos_themes = set(pos_verse.get("themes", []))

            expanded = set(rel_set)  # always include original
            for v in self.corpus:
                if v["id"] == pos_id:
                    continue
                v_themes = set(v.get("themes", []))
                overlap  = len(pos_themes & v_themes)
                if overlap >= self.threshold and len(pos_themes) > 0:
                    expanded.add(v["id"])

            ml_relevant[qid] = expanded

        # Stats
        sizes = [len(v) for v in ml_relevant.values()]
        print(f"\n📊 Multi-label ground truth:")
        print(f"   Avg relevant docs per query : {np.mean(sizes):.1f}")
        print(f"   Max relevant docs per query : {max(sizes)}")
        print(f"   Min relevant docs per query : {min(sizes)}")

        return ml_relevant

    def _retrieve(
        self, query: str, top_k: int = 10
    ) -> List[Tuple[str, float]]:
        q_emb = self.model.encode(
            [query], normalize_embeddings=True,
            show_progress_bar=False,
        )
        scores, indices = self.index.search(
            q_emb.astype(np.float32), top_k
        )
        return [
            (self.corpus_ids[i], float(s))
            for s, i in zip(scores[0], indices[0])
            if i >= 0
        ]

    def compute_map(
        self,
        retrieved: List[str],
        relevant: Set[str],
    ) -> float:
        """
        Mean Average Precision for one query.

        AP = (1/|R|) Σ_{k: doc_k relevant} Precision@k
        """
        if not relevant:
            return 0.0
        hits, ap = 0, 0.0
        for rank, doc_id in enumerate(retrieved, 1):
            if doc_id in relevant:
                hits += 1
                ap   += hits / rank
        return ap / len(relevant)

    def compute_r_precision(
        self,
        retrieved: List[str],
        relevant: Set[str],
    ) -> float:
        """
        R-Precision: Precision@|R| where R = relevant set size.
        """
        r = len(relevant)
        if r == 0:
            return 0.0
        hits = len(set(retrieved[:r]) & relevant)
        return hits / r

    def evaluate(
        self,
        k_values: List[int] = [1, 3, 5, 10],
        label: str = "Model",
    ) -> Dict:
        """
        Full multi-label evaluation.

        Returns dict with:
          MAP, R-Precision,
          MultiRecall@K, MultiPrecision@K, MultiMRR@K, MultiNDCG@K
        """
        results: Dict[str, List[float]] = {
            "MAP":         [],
            "R-Precision": [],
        }
        for k in k_values:
            for m in ["Recall", "Precision", "MRR", "nDCG"]:
                results[f"{m}@{k}"] = []

        for qid, query in self.ir_queries.items():
            relevant_sl = self.ir_relevant.get(qid, set())
            relevant_ml = self.ml_relevant.get(qid, set())

            retrieved   = self._retrieve(query, top_k=max(k_values))
            ret_ids     = [d for d, _ in retrieved]

            # MAP + R-Precision (multi-label)
            results["MAP"].append(
                self.compute_map(ret_ids, relevant_ml)
            )
            results["R-Precision"].append(
                self.compute_r_precision(ret_ids, relevant_ml)
            )

            for k in k_values:
                top_k = ret_ids[:k]
                hits  = len(set(top_k) & relevant_ml)
                n_rel = len(relevant_ml)

                results[f"Recall@{k}"].append(
                    hits / n_rel if n_rel > 0 else 0.0
                )
                results[f"Precision@{k}"].append(hits / k)

                mrr = next(
                    (1.0 / r for r, d in enumerate(top_k, 1)
                     if d in relevant_ml),
                    0.0,
                )
                results[f"MRR@{k}"].append(mrr)

                dcg  = sum(
                    1.0 / np.log2(r + 1)
                    for r, d in enumerate(top_k, 1)
                    if d in relevant_ml
                )
                idcg = sum(
                    1.0 / np.log2(r + 1)
                    for r in range(1, min(n_rel, k) + 1)
                )
                results[f"nDCG@{k}"].append(
                    dcg / idcg if idcg > 0 else 0.0
                )

        averaged = {k: float(np.mean(v)) for k, v in results.items()}

        # ── Print ──
        print(f"\n{'='*55}")
        print(f"  Multi-Label Evaluation — {label}")
        print(f"{'='*55}")
        print(f"  {'Metric':<20} {'Score':>10}")
        print(f"  {'-'*32}")
        for key in ["MAP", "R-Precision"] + [
            f"{m}@{k}"
            for m in ["Recall", "MRR", "nDCG"]
            for k in k_values
        ]:
            if key in averaged:
                print(f"  {key:<20} {averaged[key]:>10.4f}")
        print(f"{'='*55}")

        return averaged

    def compare_single_vs_multi(
        self,
        single_label_metrics: Dict,
        multi_label_metrics:  Dict,
    ):
        """Side-by-side comparison of single vs multi-label eval."""
        print(f"\n{'='*62}")
        print("  Single-Label  vs  Multi-Label  Evaluation Comparison")
        print(f"{'='*62}")
        print(f"  {'Metric':<20} {'Single':>10} {'Multi':>10} "
              f"{'Δ':>8}")
        print(f"  {'-'*50}")

        common_keys = sorted(
            set(single_label_metrics) & set(multi_label_metrics)
        )
        for key in common_keys:
            sv    = single_label_metrics.get(key, 0)
            mv    = multi_label_metrics.get(key, 0)
            delta = mv - sv
            ind   = "↑" if delta > 0.001 else ("↓" if delta < -0.001 else "≈")
            print(f"  {key:<20} {sv:>10.4f} {mv:>10.4f} "
                  f"{delta:>+7.3f} {ind}")
        print(f"{'='*62}")
        print(
            "\n  ℹ️  Multi-label metrics are typically higher because\n"
            "     multiple valid answers are accepted per query.\n"
            "     MAP and R-Precision are the most informative\n"
            "     multi-label metrics for this corpus."
        )


# ── Run multi-label evaluation ──
print("🔍 Building multi-label evaluator...")
ml_evaluator = MultiLabelEvaluator(
    model    = best_mnrl,
