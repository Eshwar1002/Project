## Cell 11: Advanced RAG System with Query Expansion

```python
# ════════════════════════════════════════════════════════════
# ADVANCED RAG SYSTEM
# Enhancements over basic RAG:
# 1. Query expansion via Sanskrit synonym substitution
# 2. BM25 + dense hybrid retrieval (score fusion)
# 3. Two-stage reranking integration
# 4. Response confidence scoring
# 5. Contextual summary generation
# ════════════════════════════════════════════════════════════

class AdvancedSanskritRAG:
    """
    Production-grade RAG for Sanskrit-English retrieval.

    Pipeline:
      Query → Expand → [Dense + Sparse Hybrid] → Rerank → Format
    """

    # Sanskrit synonym map for query expansion
    EXPANSION_MAP: Dict[str, List[str]] = {
        "karma":      ["action", "duty", "deed", "nishkama karma"],
        "soul":       ["atma", "atman", "self", "spirit"],
        "dharma":     ["duty", "righteousness", "cosmic law"],
        "yoga":       ["discipline", "union", "path"],
        "bhakti":     ["devotion", "love", "surrender"],
        "moksha":     ["liberation", "freedom", "mukti"],
        "maya":       ["illusion", "material nature"],
        "mind":       ["manas", "thought", "consciousness"],
        "god":        ["krishna", "brahman", "supreme"],
        "guru":       ["teacher", "master", "preceptor"],
        "sattva":     ["goodness", "purity", "clarity"],
        "rajas":      ["passion", "activity", "restlessness"],
        "tamas":      ["ignorance", "inertia", "darkness"],
        "rebirth":    ["reincarnation", "transmigration", "samsara"],
        "detachment": ["non-attachment", "vairagya", "tyaga"],
    }

    def __init__(
        self,
        bi_encoder:    SentenceTransformer,
        corpus:        List[Dict],
        two_stage:     Optional[TwoStageRetriever] = None,
        top_k:         int = 3,
        use_hybrid:    bool = True,
        use_expansion: bool = True,
    ):
        self.bi_encoder    = bi_encoder
        self.corpus        = corpus
        self.corpus_by_id  = {v["id"]: v for v in corpus}
        self.two_stage     = two_stage
        self.top_k         = top_k
        self.use_hybrid    = use_hybrid
        self.use_expansion = use_expansion

        # Build dense index
        self._build_dense_index()

        # Build BM25 index
        self.corp_ids   = [v["id"] for v in corpus]
        tokenised       = [
            self._tokenise(
                v.get("translation", "") + " " +
                " ".join(v.get("keywords", []))
            )
            for v in corpus
        ]
        self.bm25 = BM25Okapi(tokenised)

        print("✅ Advanced RAG system ready!")
        print(f"   Dense index    : {len(corpus)} vectors")
        print(f"   BM25 index     : {len(corpus)} documents")
        print(f"   Hybrid fusion  : {'on' if use_hybrid    else 'off'}")
        print(f"   Query expansion: {'on' if use_expansion else 'off'}")

    def _tokenise(self, text: str) -> List[str]:
        return re.sub(r"[^\w\s]", " ", text.lower()).split()

    def _get_doc_text(self, v: Dict) -> str:
        return " | ".join(filter(None, [
            v.get("sanskrit",        ""),
            v.get("transliteration", ""),
            v.get("translation",     ""),
            f"Topics: {', '.join(v.get('themes', []))}",
        ]))

    def _build_dense_index(self):
        texts = [self._get_doc_text(v) for v in self.corpus]
        emb   = self.bi_encoder.encode(
            texts, normalize_embeddings=True,
            show_progress_bar=False, batch_size=32,
        )
        dim        = emb.shape[1]
        self.index = faiss.IndexFlatIP(dim)
        self.index.add(emb.astype(np.float32))
        self.corpus_emb = emb

    # ─────────────────────────────────────────────
    # Query Expansion
    # ─────────────────────────────────────────────
    def expand_query(self, query: str) -> str:
        """
        Expand query with Sanskrit synonyms.

        Example:
          "What is atma?" → "What is atma? soul self spirit atman"
        """
        if not self.use_expansion:
            return query

        query_lower  = query.lower()
        expansions   = []

        for term, synonyms in self.EXPANSION_MAP.items():
            if term in query_lower or any(
                s in query_lower for s in synonyms[:2]
            ):
                # Add synonyms not already in query
                new_syns = [
                    s for s in synonyms
                    if s not in query_lower
                ][:2]
                expansions.extend(new_syns)

        if expansions:
            expanded = query + " " + " ".join(set(expansions))
            return expanded
        return query

    # ─────────────────────────────────────────────
    # Hybrid Retrieval (Dense + Sparse)
    # ─────────────────────────────────────────────
    def _dense_retrieve(
        self, query: str, top_k: int
    ) -> Dict[str, float]:
        q_emb = self.bi_encoder.encode(
            [query], normalize_embeddings=True,
            show_progress_bar=False,
        )
        scores, indices = self.index.search(
            q_emb.astype(np.float32), top_k
        )
        return {
            self.corp_ids[i]: float(s)
            for s, i in zip(scores[0], indices[0])
            if i >= 0
        }

    def _sparse_retrieve(
        self, query: str, top_k: int
    ) -> Dict[str, float]:
        tokens = self._tokenise(query)
        scores = self.bm25.get_scores(tokens)

        # Normalise BM25 scores to [0, 1]
        max_s  = scores.max() if scores.max() > 0 else 1.0
        normed = scores / max_s

        ranked = np.argsort(normed)[::-1][:top_k]
        return {
            self.corp_ids[i]: float(normed[i])
            for i in ranked
        }

    def hybrid_retrieve(
        self,
        query: str,
        top_k: int,
        alpha: float = 0.7,
    ) -> List[Tuple[str, float]]:
        """
        Reciprocal Rank Fusion of dense + sparse scores.

        Fused score = α × dense_norm + (1-α) × sparse_norm

        α = 0.7 weights dense retrieval more heavily, appropriate
        for semantic queries.  α = 0.5 for balanced retrieval.
        """
        if not self.use_hybrid:
            dense = self._dense_retrieve(query, top_k)
            return sorted(dense.items(), key=lambda x: x[1],
                          reverse=True)[:top_k]

        dense  = self._dense_retrieve(query, top_k * 2)
        sparse = self._sparse_retrieve(query, top_k * 2)

        all_ids = set(dense) | set(sparse)
        fused   = {}
        for doc_id in all_ids:
            d_score = dense.get(doc_id,  0.0)
            s_score = sparse.get(doc_id, 0.0)
            fused[doc_id] = alpha * d_score + (1 - alpha) * s_score

        return sorted(fused.items(), key=lambda x: x[1],
                      reverse=True)[:top_k]

    # ─────────────────────────────────────────────
    # Confidence Scoring
    # ─────────────────────────────────────────────
    def _confidence(
        self, results: List[Tuple[str, float]]
    ) -> str:
        """
        Estimate retrieval confidence from score gap.

        If top-1 score is >> top-2 score, the model is confident.
        """
        if len(results) < 2:
            return "high"
        gap = results[0][1] - results[1][1]
        if gap > 0.15:
            return "high   🟢"
        elif gap > 0.07:
            return "medium 🟡"
        else:
            return "low    🔴"

    # ─────────────────────────────────────────────
    # Main Query Interface
    # ─────────────────────────────────────────────
    def query(
        self,
        question:    str,
        alpha:       float = 0.7,
        show_expansion: bool = True,
    ) -> str:
        """
        Full RAG query with expansion + hybrid + reranking.
        """
        t0 = time.time()

        # 1. Query expansion
        expanded = self.expand_query(question)

        # 2. Hybrid retrieval
        raw_results = self.hybrid_retrieve(
            expanded, top_k=self.top_k * 4, alpha=alpha
        )

        # 3. Optional cross-encoder reranking
        if self.two_stage is not None:
            stage2 = self.two_stage.rerank_stage2(
                question,
                [(d, s) for d, s in raw_results[:20]],
            )
            final_results = [
                (d, s2) for d, s1, s2 in stage2[:self.top_k]
            ]
        else:
            final_results = raw_results[:self.top_k]

        confidence = self._confidence(final_results)
        elapsed_ms = round((time.time() - t0) * 1000, 1)

        # 4. Format response
        return self._format(
            question, expanded, final_results,
            confidence, elapsed_ms, show_expansion,
        )

    def _format(
        self,
        question:    str,
        expanded:    str,
        results:     List[Tuple[str, float]],
        confidence:  str,
        elapsed_ms:  float,
        show_expansion: bool,
    ) -> str:
        verses    = [self.corpus_by_id.get(d, {}) for d, _ in results]
        all_themes = []
        for v in verses:
            all_themes.extend(v.get("themes", []))
        top_themes = list(dict.fromkeys(all_themes))[:5]

        lines = [
            "",
            "╔════════════════════════════════════════════════════════════╗",
            "║           ADVANCED SANSKRIT-ENGLISH RAG SYSTEM            ║",
            "╚════════════════════════════════════════════════════════════╝",
            f"  📝 Query      : {question}",
        ]

        if show_expansion and expanded != question:
            lines.append(f"  🔤 Expanded   : {expanded[:90]}...")

        lines += [
            f"  ⚡ Latency    : {elapsed_ms} ms",
            f"  🎯 Confidence : {confidence}",
            "",
            "═" * 64,
            f"  📚 TOP-{len(results)} RETRIEVED PASSAGES",
            "═" * 64,
        ]

        for rank, ((doc_id, score), verse) in enumerate(
            zip(results, verses), 1
        ):
            ch   = verse.get("chapter", "?")
            vn   = verse.get("verse",   "?")
            san  = verse.get("sanskrit",        "")
            iast = verse.get("transliteration", "")
            eng  = verse.get("translation",     "")
            tags = ", ".join(verse.get("themes", []))

            lines += [
                "",
                f"  ┌─ #{rank}  {doc_id}  Ch.{ch} V.{vn}  "
                f"Score: {score:.4f} " + "─" * 10,
                f"  │ 🕉  {san[:85]}",
                f"  │     {'...' if len(san) > 85 else ''}",
                f"  │ 🔤  {iast[:85]}",
                f"  │     {'...' if len(iast) > 85 else ''}",
                f"  │ 📖  {eng}",
                f"  │ 🏷  {tags}",
                "  └" + "─" * 60,
            ]

        lines += [
            "",
            "═" * 64,
            "  💡 SUMMARY",
            "─" * 64,
            f"  Key themes  : {', '.join(top_themes)}",
            f"  Chapters    : {sorted({v.get('chapter',0) for v in verses})}",
            "",
            "  In a full RAG pipeline, these passages would be passed",
            "  as context to an LLM (LLaMA-3, Mistral, Gemma) for",
            "  grounded answer generation.",
            "═" * 64,
            "",
        ]
        return "\n".join(lines)


