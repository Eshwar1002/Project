## Cell 4: BM25 Hard Negative Mining

```python
# ════════════════════════════════════════════════════════════
# BM25 HARD NEGATIVE MINER
# Retrieves lexically similar but semantically different
# verses using TF-IDF style sparse retrieval (BM25).
#
# Why BM25 negatives?
#   A dense model trained only on random negatives never
#   learns to distinguish "karma as action" from "karma as
#   fate" — both mention "karma".  BM25 finds exactly these
#   lexically confusable verses, forcing fine-grained
#   semantic learning.
# ════════════════════════════════════════════════════════════

class BM25HardNegativeMiner:
    """
    Mines hard negatives using BM25 sparse retrieval.

    Strategy:
      For each (query, positive_verse) pair:
        1. Run BM25 over the corpus using the query
        2. Retrieve top-K verses (excluding the true positive)
        3. These are lexically similar but may not be semantically
           correct — ideal hard negatives
    """

    def __init__(self, corpus: List[Dict]):
        self.corpus       = corpus
        self.corpus_by_id = {v["id"]: v for v in corpus}
        self.corpus_ids   = [v["id"] for v in corpus]

        # Build BM25 index over tokenised translations
        tokenised_docs    = [
            self._tokenise(v.get("translation", "") + " " +
                           " ".join(v.get("keywords", [])))
            for v in corpus
        ]
        self.bm25         = BM25Okapi(tokenised_docs)
        print(f"✅ BM25 index built over {len(corpus)} documents")

    def _tokenise(self, text: str) -> List[str]:
        """Simple whitespace + lowercase tokenisation."""
        text = text.lower()
        text = re.sub(r"[^\w\s]", " ", text)
        return text.split()

    def mine(
        self,
        training_pairs: List[Dict],
        top_k: int = 5,
        max_negatives_per_pair: int = 2,
    ) -> List[Dict]:
        """
        Mine hard negatives for all training pairs.

        Returns triplets with 'bm25' neg_strategy label.
        """
        triplets = []

        for pair in tqdm(training_pairs,
                         desc="⛏️  BM25 hard negative mining"):
            query      = pair["query"]
            pos_id     = pair["positive_id"]
            pos_verse  = self.corpus_by_id.get(pos_id)
            if not pos_verse:
                continue

            # BM25 retrieval
            tokens      = self._tokenise(query)
            scores      = self.bm25.get_scores(tokens)
            ranked_idx  = np.argsort(scores)[::-1]

            # Collect negatives: high BM25 score but != positive
            negatives   = []
            for idx in ranked_idx:
                neg_id  = self.corpus_ids[idx]
                if neg_id == pos_id:
                    continue
                # Exclude verses with full theme overlap
                # (they might actually be correct answers)
                neg_verse = self.corpus_by_id[neg_id]
                pos_themes = set(pos_verse.get("themes", []))
                neg_themes = set(neg_verse.get("themes", []))
                full_overlap = (
                    len(pos_themes) > 0 and
                    pos_themes == neg_themes
                )
                if not full_overlap:
                    negatives.append((neg_id, float(scores[idx])))
                if len(negatives) >= max_negatives_per_pair:
                    break

            # Build triplets
            for neg_id, bm25_score in negatives:
                triplets.append({
                    "query":        pair["query"],
                    "positive_id":  pos_id,
                    "negative_id":  neg_id,
                    "query_type":   pair.get("query_type", "unknown"),
                    "neg_strategy": "bm25",
                    "bm25_score":   bm25_score,
                })

        print(f"✅ BM25 mined {len(triplets)} hard negative triplets")
        return triplets

    def analyse_negatives(self, triplets: List[Dict], n: int = 5):
        """Show sample BM25 negatives for manual inspection."""
        print(f"\n🔍 Sample BM25 Hard Negatives:")
        bm25_samples = [t for t in triplets
                        if t["neg_strategy"] == "bm25"][:n]
        for t in bm25_samples:
            pos = self.corpus_by_id[t["positive_id"]]
            neg = self.corpus_by_id[t["negative_id"]]
            print(f"\n  Query    : {t['query'][:60]}")
            print(f"  Positive : [{t['positive_id']}] "
                  f"{pos['translation'][:70]}...")
            print(f"  Negative : [{t['negative_id']}] "
                  f"(BM25={t['bm25_score']:.2f}) "
                  f"{neg['translation'][:70]}...")
            print(f"  Pos themes: {pos.get('themes', [])}")
            print(f"  Neg themes: {neg.get('themes', [])}")
