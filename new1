                    )
                    idcg = sum(
                        1.0 / np.log2(r + 1)
                        for r in range(1, min(len(relevant), k) + 1)
                    )
                    store[f"nDCG@{k}"].append(
                        dcg / idcg if idcg > 0 else 0.0
                    )

        s1_avg = {k: float(np.mean(v)) for k, v in s1_metrics.items()}
        s2_avg = {k: float(np.mean(v)) for k, v in s2_metrics.items()}

        # ── Print comparison table ──
