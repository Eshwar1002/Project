            for m in ["Recall", "MRR", "nDCG"]
            for k in k_values
        }

        for qid, query in tqdm(
            ir_queries.items(),
            desc="⚖️  Evaluating two-stage pipeline"
        ):
            relevant = ir_relevant.get(qid, set())
            result   = self.retrieve(query)

            s1_ids = [d for d, _    in result["stage1_results"]]
            s2_ids = [d for d, _, _ in result["stage2_results"]]

            for k in k_values:
                for ids, store in [(s1_ids, s1_metrics),
                                   (s2_ids, s2_metrics)]:
                    top_k = ids[:k]
                    hits  = len(set(top_k) & relevant)

                    store[f"Recall@{k}"].append(
                        hits / len(relevant) if relevant else 0.0
                    )
                    mrr = next(
