def plot_full_dashboard(
    all_metrics: Dict[str, Dict],
    two_stage_s1: Dict,
    two_stage_s2: Dict,
    figsize: Tuple = (20, 16),
):
    """
    5-panel publication-quality dashboard.

    Panel 1: Recall@K — all models
