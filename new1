class ClassicNegativeMiner:
    """Same-chapter + theme-overlap + random negative mining."""

    def __init__(self, corpus: List[Dict]):
        self.corpus       = corpus
        self.corpus_by_id = {v["id"]: v for v in corpus}
        self.by_chapter   = defaultdict(list)
        for v in corpus:
            self.by_chapter[v["chapter"]].append(v["id"])

    def mine(self, pairs: List[Dict]) -> List[Dict]:
        triplets = []
        for pair in pairs:
            pos_id    = pair["positive_id"]
            pos_verse = self.corpus_by_id.get(pos_id)
            if not pos_verse:
                continue
            pos_themes = set(pos_verse.get("themes", []))

            # Tier 1: same chapter
            same_ch = [
                vid for vid in
                self.by_chapter[pos_verse["chapter"]]
                if vid != pos_id
            ]
            # Tier 2: theme overlap (1–2 shared)
            theme_overlap = [
                v["id"] for v in self.corpus
                if v["id"] != pos_id and
                1 <= len(set(v.get("themes", [])) & pos_themes) <= 2
            ]
            # Tier 3: random
            all_ids  = [
                v["id"] for v in self.corpus if v["id"] != pos_id
            ]
            rand_neg = random.sample(all_ids, min(3, len(all_ids)))

            neg_pool = []
            if same_ch:
                neg_pool += random.sample(same_ch, min(1, len(same_ch)))
            if theme_overlap:
                neg_pool += random.sample(
                    theme_overlap, min(1, len(theme_overlap))
                )
            neg_pool += random.sample(rand_neg, min(1, len(rand_neg)))

            for neg_id in neg_pool[:2]:
                strategy = (
                    "hard"
                    if neg_id in same_ch or neg_id in theme_overlap
                    else "random"
                )
                triplets.append({
                    "query":        pair["query"],
                    "positive_id":  pos_id,
                    "negative_id":  neg_id,
                    "query_type":   pair.get("query_type", "unknown"),
                    "neg_strategy": strategy,
                })
        return triplets


classic_miner    = ClassicNegativeMiner(raw_corpus)
