        ax.legend(fontsize=7, ncol=2)
        ax.set_ylim(0, 1.15)
        ax.grid(axis="y", alpha=0.25, linestyle="--")
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)

    # ── Panel 4: Two-stage comparison ──
    ax = axes[3]
    k3 = [1, 3, 5]
    x3 = np.arange(len(k3))

    for j, (stage_name, stage_data, color) in enumerate([
        ("Stage-1 (Dense)",     two_stage_s1, "#3498DB"),
        ("Stage-2 (Re-ranked)", two_stage_s2, "#E74C3C"),
    ]):
        vals = [stage_data.get(f"Recall@{k}", 0) for k in k3]
        bars = ax.bar(
            x3 + j * 0.35, vals, 0.35,
            label=stage_name, color=color,
            alpha=0.85, edgecolor="black", linewidth=0.4,
        )
        for bar in bars:
            h = bar.get_height()
            if h > 0.02:
                ax.text(
                    bar.get_x() + bar.get_width() / 2.,
                    h + 0.008, f"{h:.3f}",
                    ha="center", va="bottom", fontsize=8,
                )

    ax.set_xticks(x3 + 0.175)
    ax.set_xticklabels([f"@{k}" for k in k3])
    ax.set_xlabel("K", fontsize=10)
    ax.set_ylabel("Recall@K", fontsize=10)
    ax.set_title("Two-Stage Retrieval\nStage-1 vs Stage-2 Recall@K",
                 fontsize=11, fontweight="bold")
    ax.legend(fontsize=9)
    ax.set_ylim(0, 1.15)
    ax.grid(axis="y", alpha=0.25, linestyle="--")
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    # ── Panel 5: Improvement heatmap over baseline ──
    ax        = axes[4]
    baseline  = all_metrics.get(
        "Baseline",
        all_metrics[list(all_metrics.keys())[0]]
    )
    non_base  = [n for n in model_names if n != "Baseline"]

    imp_matrix = np.zeros((len(non_base), len(k_values) * 3))
    col_labels = [
        f"{m}@{k}"
        for m in ["Recall", "MRR", "nDCG"]
        for k in k_values
    ]

    for i, name in enumerate(non_base):
        for j, col in enumerate(col_labels):
            imp_matrix[i, j] = (
                all_metrics[name].get(col, 0)
                - baseline.get(col, 0)
            )

    im = ax.imshow(
        imp_matrix, cmap="RdYlGn",
        aspect="auto", vmin=-0.25, vmax=0.25,
    )
    ax.set_xticks(range(len(col_labels)))
    ax.set_xticklabels(col_labels, rotation=45,
                       ha="right", fontsize=8)
    ax.set_yticks(range(len(non_base)))
    ax.set_yticklabels(non_base, fontsize=10)

    for i in range(len(non_base)):
        for j in range(len(col_labels)):
            val   = imp_matrix[i, j]
            color = "white" if abs(val) > 0.12 else "black"
            ax.text(
                j, i, f"{val:+.2f}",
                ha="center", va="center",
                fontsize=7.5, color=color, fontweight="bold",
            )

    plt.colorbar(im, ax=ax, shrink=0.6,
                 label="Improvement over Baseline")
    ax.set_title(
        "Improvement Heatmap vs Baseline  "
        "(Green = better, Red = worse)",
        fontsize=11, fontweight="bold",
    )

    fig.suptitle(
        "Advanced Sanskrit-English Retrieval — Full Results Dashboard",
        fontsize=15, fontweight="bold", y=1.01,
    )

    plt.savefig(
        "full_dashboard.png",
        dpi=150, bbox_inches="tight",
    )
    plt.show()
    print("✅ Full dashboard saved → full_dashboard.png")


