print("\n📊 Baseline evaluation...")
from sentence_transformers import SentenceTransformer as ST

def quick_eval(
    model: SentenceTransformer,
    ir_queries: Dict, ir_corpus: Dict, ir_relevant: Dict,
    name: str = "model",
    k_values: List[int] = [1, 3, 5, 10],
) -> Dict:
    """Fast inline evaluator."""
    corpus_ids   = list(ir_corpus.keys())
    corpus_texts = list(ir_corpus.values())
    corpus_emb   = model.encode(
        corpus_texts, normalize_embeddings=True,
        show_progress_bar=False, batch_size=32,
    )
    query_ids    = list(ir_queries.keys())
    query_texts  = list(ir_queries.values())
    query_emb    = model.encode(
        query_texts, normalize_embeddings=True,
        show_progress_bar=False, batch_size=32,
    )

    dim   = corpus_emb.shape[1]
    index = faiss.IndexFlatIP(dim)
    index.add(corpus_emb.astype(np.float32))
    scores, indices = index.search(
        query_emb.astype(np.float32), max(k_values)
    )

    metrics: Dict[str, List[float]] = {
        f"{m}@{k}": []
        for m in ["Recall", "Precision", "MRR", "nDCG"]
        for k in k_values
    }

    for qid, score_row, idx_row in zip(query_ids, scores, indices):
        relevant     = ir_relevant.get(qid, set())
        retrieved    = [corpus_ids[i] for i in idx_row if i >= 0]
        for k in k_values:
            top_k = retrieved[:k]
            hits  = len(set(top_k) & relevant)
            metrics[f"Recall@{k}"].append(
                hits / len(relevant) if relevant else 0
            )
            metrics[f"Precision@{k}"].append(hits / k)
            mrr = next(
                (1.0/r for r, d in enumerate(top_k, 1)
                 if d in relevant), 0.0
            )
            metrics[f"MRR@{k}"].append(mrr)
            dcg = sum(
                1/np.log2(r+1)
                for r, d in enumerate(top_k, 1) if d in relevant
            )
            idcg = sum(
                1/np.log2(r+1)
                for r in range(1, min(len(relevant), k)+1)
            )
            metrics[f"nDCG@{k}"].append(
                dcg/idcg if idcg > 0 else 0
            )

    avg = {k: float(np.mean(v)) for k, v in metrics.items()}

    print(f"\n{'─'*45}")
    print(f"  {name}")
