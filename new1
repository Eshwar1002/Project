    def _merge_corpora(
        self,
        core: List[Dict],
        hf: List[Dict]
    ) -> List[Dict]:
        """Merge corpora, keeping core entries as authoritative."""
        core_ids = {v["id"] for v in core}
        # Keep all core verses + non-duplicate HF verses
        merged = core.copy()
        for v in hf:
            if v["id"] not in core_ids:
                merged.append(v)
        print(f"   Merged: {len(core)} core + "
              f"{len(merged)-len(core)} HF = {len(merged)} total")
        return merged

    def _infer_themes(self, corpus: List[Dict]) -> List[Dict]:
        """
        Automatically infer themes from translation text using
        the THEME_KEYWORDS taxonomy.  Supplements existing themes.
        """
        for v in corpus:
            text           = (v.get("translation", "") + " " +
                              " ".join(v.get("keywords", []))).lower()
            inferred       = set(v.get("themes", []))
            for theme, kws in self.THEME_KEYWORDS.items():
                if any(kw in text for kw in kws):
                    inferred.add(theme)
            v["themes"]    = sorted(inferred)
            # Regenerate keywords from themes
            kw_set = set(v.get("keywords", []))
            for theme in v["themes"]:
                kw_set.update(self.THEME_KEYWORDS.get(theme, [])[:3])
            v["keywords"]  = sorted(kw_set)[:12]
        return corpus

    def _deduplicate(self, corpus: List[Dict]) -> List[Dict]:
        """Remove duplicate verses by (chapter, verse) key."""
        seen, unique = set(), []
        for v in corpus:
            key = (v.get("chapter", -1), v.get("verse", -1))
            if key not in seen:
                seen.add(key)
                unique.append(v)
        return unique

    def _quality_filter(
        self,
        corpus: List[Dict],
        min_translation_len: int = 30
    ) -> List[Dict]:
        """Remove verses with very short translations."""
        filtered = [
            v for v in corpus
            if len(v.get("translation", "")) >= min_translation_len
        ]
        removed = len(corpus) - len(filtered)
        if removed:
            print(f"   Quality filter: removed {removed} short entries")
        return filtered

    def _print_stats(self):
        chapters = [v["chapter"] for v in self.verses if v["chapter"] > 0]
