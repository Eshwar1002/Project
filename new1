# ════════════════════════════════════════════════════════════
# TWO-STAGE RETRIEVAL PIPELINE
# Stage 1: Dense bi-encoder retrieval (fast, top-20)
# Stage 2: Cross-encoder re-ranking  (precise, top-3)
#
# Why two stages?
#   Bi-encoders encode query and document independently →
#   O(1) query time with pre-built index, but miss fine-grained
#   token-level interactions.
#
#   Cross-encoders jointly encode (query, document) pair →
#   capture exact token interactions but O(N) query time.
#
#   Two-stage: run bi-encoder on ALL docs, then cross-encoder
#   only on top-K candidates → best of both worlds.
# ════════════════════════════════════════════════════════════

class TwoStageRetriever:
    """
    Stage 1: FAISS dense retrieval with fine-tuned bi-encoder
    Stage 2: Cross-encoder re-ranking on top-20 candidates
    """

    def __init__(
        self,
        bi_encoder: SentenceTransformer,
        corpus: List[Dict],
        stage1_top_k: int = 20,
        stage2_top_k: int = 3,
    ):
        self.bi_encoder    = bi_encoder
        self.corpus        = corpus
        self.corpus_by_id  = {v["id"]: v for v in corpus}
        self.stage1_top_k  = stage1_top_k
        self.stage2_top_k  = stage2_top_k

        # Load cross-encoder
        print(f"⏳ Loading cross-encoder: "
              f"{CFG.cross_encoder_model}")
        try:
            self.cross_encoder = CrossEncoder(
                CFG.cross_encoder_model, device=DEVICE
            )
            print("✅ Cross-encoder loaded")
        except Exception as e:
            print(f"⚠️  Cross-encoder load failed: {e}")
            self.cross_encoder = None

        # Build bi-encoder index
        self._build_index()

    def _get_doc_text(self, v: Dict) -> str:
        return " | ".join(filter(None, [
            v.get("transliteration", ""),
            v.get("translation",     ""),
            f"Topics: {', '.join(v.get('themes', []))}",
        ]))

    def _build_index(self):
        print("⏳ Building FAISS index...")
        self.corpus_ids   = [v["id"] for v in self.corpus]
        self.corpus_texts = [
            self._get_doc_text(v) for v in self.corpus
        ]
        emb = self.bi_encoder.encode(
            self.corpus_texts,
            normalize_embeddings=True,
            show_progress_bar=True,
            batch_size=32,
        )
        dim        = emb.shape[1]
        self.index = faiss.IndexFlatIP(dim)
        self.index.add(emb.astype(np.float32))
        self.corpus_emb = emb
        print(f"✅ Index built: {self.index.ntotal} vectors")

    def retrieve_stage1(
        self, query: str
    ) -> List[Tuple[str, float]]:
        """Dense bi-encoder retrieval."""
        q_emb = self.bi_encoder.encode(
            [query], normalize_embeddings=True,
            show_progress_bar=False,
        )
        scores, indices = self.index.search(
            q_emb.astype(np.float32), self.stage1_top_k
        )
        return [
            (self.corpus_ids[i], float(s))
            for s, i in zip(scores[0], indices[0])
            if i >= 0
        ]

    def rerank_stage2(
        self,
        query: str,
        candidates: List[Tuple[str, float]],
    ) -> List[Tuple[str, float, float]]:
        """
        Cross-encoder re-ranking.
        Returns (doc_id, bi_encoder_score, cross_encoder_score).
        """
        if self.cross_encoder is None:
            # Fallback: return bi-encoder ranking
            return [
                (doc_id, score, score)
                for doc_id, score in candidates[:self.stage2_top_k]
            ]

        pairs = [
            [query, self._get_doc_text(self.corpus_by_id[doc_id])]
            for doc_id, _ in candidates
        ]

        ce_scores = self.cross_encoder.predict(
            pairs, show_progress_bar=False
        )

        reranked = sorted(
            zip([c[0] for c in candidates],
                [c[1] for c in candidates],
                ce_scores),
            key=lambda x: x[2], reverse=True,
        )
        return reranked[:self.stage2_top_k]

    def retrieve(
        self, query: str
    ) -> Dict[str, List]:
        """Full two-stage retrieval pipeline."""
        t0 = time.time()

        # Stage 1
        stage1_results = self.retrieve_stage1(query)
        t1 = time.time()

        # Stage 2
        stage2_results = self.rerank_stage2(query, stage1_results)
        t2 = time.time()

        return {
            "query":          query,
            "stage1_results": stage1_results,
            "stage2_results": stage2_results,
            "stage1_ms":      round((t1 - t0) * 1000, 2),
            "stage2_ms":      round((t2 - t1) * 1000, 2),
            "total_ms":       round((t2 - t0) * 1000, 2),
        }

