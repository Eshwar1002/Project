        print("✅ Similarity distribution plot saved!")

    # ─────────────────────────────────────────────────────
    # 3. Per-Theme Recall@K Heatmap
    # ─────────────────────────────────────────────────────
    def plot_per_theme_recall(
        self,
        model: SentenceTransformer,
        ir_queries: Dict,
        ir_relevant: Dict,
        k_values: List[int] = [1, 3, 5, 10],
        figsize: Tuple = (12, 8),
    ):
        """
        Heatmap: theme vs K value, cell = Recall@K
        for queries whose positive verse has that theme.
        """
        corpus_by_id = {v["id"]: v for v in self.corpus}

        # Encode corpus once
        corp_ids   = [v["id"] for v in self.corpus]
        corp_texts = [
            " | ".join(filter(None, [
                v.get("transliteration", ""),
                v.get("translation",     ""),
            ]))
            for v in self.corpus
        ]
        c_emb = model.encode(
            corp_texts, normalize_embeddings=True,
            show_progress_bar=False, batch_size=32,
        )
        dim   = c_emb.shape[1]
        index = faiss.IndexFlatIP(dim)
        index.add(c_emb.astype(np.float32))

        # Per-theme recall accumulator
        theme_recall: Dict[str, Dict[int, List[float]]] = defaultdict(
            lambda: {k: [] for k in k_values}
        )

        for qid, query in ir_queries.items():
            relevant  = ir_relevant.get(qid, set())
            pos_id    = list(relevant)[0] if relevant else None
            if not pos_id:
                continue
            pos_verse = corpus_by_id.get(pos_id, {})
            themes    = pos_verse.get("themes", ["unknown"])
            if not themes:
                themes = ["unknown"]

            q_emb = model.encode(
                [query], normalize_embeddings=True,
                show_progress_bar=False,
            )
            scores, indices = index.search(
                q_emb.astype(np.float32), max(k_values)
            )
            ret_ids = [corp_ids[i] for i in indices[0] if i >= 0]

            for theme in themes:
                for k in k_values:
                    hits = len(set(ret_ids[:k]) & relevant)
                    recall = hits / len(relevant) if relevant else 0.0
                    theme_recall[theme][k].append(recall)

        # Build matrix
        all_themes   = sorted(theme_recall.keys())
        matrix       = np.zeros((len(all_themes), len(k_values)))

        for i, theme in enumerate(all_themes):
            for j, k in enumerate(k_values):
                vals = theme_recall[theme][k]
                matrix[i, j] = np.mean(vals) if vals else 0.0

        # Sort themes by Recall@1 descending
        sort_idx   = np.argsort(-matrix[:, 0])
        matrix     = matrix[sort_idx]
        all_themes = [all_themes[i] for i in sort_idx]

        fig, ax = plt.subplots(figsize=figsize)
        im = ax.imshow(
            matrix, cmap="YlOrRd",
            aspect="auto", vmin=0, vmax=1,
        )

        ax.set_xticks(range(len(k_values)))
        ax.set_xticklabels([f"@{k}" for k in k_values], fontsize=11)
        ax.set_yticks(range(len(all_themes)))
        ax.set_yticklabels(all_themes, fontsize=10)

        # Annotate cells
        for i in range(len(all_themes)):
            for j in range(len(k_values)):
                val   = matrix[i, j]
                color = "white" if val > 0.6 else "black"
                ax.text(
                    j, i, f"{val:.2f}",
                    ha="center", va="center",
                    fontsize=9, color=color, fontweight="bold",
                )

        plt.colorbar(im, ax=ax, label="Recall@K")
        ax.set_title(
            "Per-Theme Recall@K Heatmap\n"
            "(sorted by Recall@1 descending)",
            fontsize=13, fontweight="bold",
        )
        ax.set_xlabel("K", fontsize=12)
        ax.set_ylabel("Theme", fontsize=12)

        plt.tight_layout()
        plt.savefig(
            "per_theme_recall_heatmap.png",
            dpi=150, bbox_inches="tight",
        )
        plt.show()
        print("✅ Per-theme recall heatmap saved!")
        return matrix, all_themes

