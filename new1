    def plot_similarity_distributions(
        self,
        ir_queries: Dict,
        ir_relevant: Dict,
        figsize: Tuple = (14, 5),
    ):
        """
        Distribution of cosine similarity scores for:
        - Positive (query, relevant-doc) pairs
        - Negative (query, random-doc)   pairs

        For each model in self.models.
        A well-trained model has clear separation between
        positive and negative distributions.
        """
        fig, axes = plt.subplots(
            1, len(self.models), figsize=figsize, sharey=True
        )
        if len(self.models) == 1:
            axes = [axes]

        for ax, (name, model) in zip(axes, self.models.items()):
            # Encode all
            corpus_texts = [
                " | ".join(filter(None, [
                    v.get("transliteration", ""),
                    v.get("translation",     ""),
                ]))
                for v in self.corpus
            ]
            corpus_ids = [v["id"] for v in self.corpus]

            c_emb = model.encode(
                corpus_texts, normalize_embeddings=True,
                show_progress_bar=False, batch_size=32,
            )
            c_map = dict(zip(corpus_ids, c_emb))

            pos_sims, neg_sims = [], []

            for qid, query in list(ir_queries.items())[:100]:
                relevant = ir_relevant.get(qid, set())
                q_emb    = model.encode(
                    [query], normalize_embeddings=True,
                    show_progress_bar=False,
                )[0]

                for v in self.corpus:
                    sim = float(np.dot(q_emb, c_map[v["id"]]))
                    if v["id"] in relevant:
                        pos_sims.append(sim)
                    else:
                        neg_sims.append(sim)

            ax.hist(
                neg_sims, bins=40, alpha=0.6,
                color="#FF6B6B", label="Negative pairs",
                density=True, edgecolor="none",
            )
            ax.hist(
                pos_sims, bins=20, alpha=0.8,
                color="#4ECDC4", label="Positive pairs",
                density=True, edgecolor="none",
            )

            # Vertical lines at means
            ax.axvline(
                np.mean(neg_sims), color="#c0392b",
                linestyle="--", linewidth=1.5,
                label=f"Neg mean={np.mean(neg_sims):.3f}",
            )
            ax.axvline(
                np.mean(pos_sims), color="#16a085",
                linestyle="--", linewidth=1.5,
                label=f"Pos mean={np.mean(pos_sims):.3f}",
            )

            sep = np.mean(pos_sims) - np.mean(neg_sims)
            ax.set_title(
                f"{name}\nSim Distribution  "
                f"(separation={sep:.3f})",
                fontsize=11, fontweight="bold",
            )
            ax.set_xlabel("Cosine Similarity")
            ax.set_ylabel("Density")
            ax.legend(fontsize=8)
            ax.grid(alpha=0.25, linestyle="--")
            ax.spines["top"].set_visible(False)
            ax.spines["right"].set_visible(False)

        fig.suptitle(
            "Positive vs Negative Similarity Distributions",
            fontsize=13, fontweight="bold", y=1.02,
