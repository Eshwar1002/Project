class ErrorAnalyzer:
    """
    Systematic error analysis to understand model failure modes.
    
    Failure types:
    - same_chapter_confusion : retrieved correct chapter, wrong verse
    - theme_confusion        : retrieved verse with partial theme overlap
    - wrong_retrieval        : no meaningful overlap with expected verse
    """
    
    def __init__(self, evaluator: RetrievalEvaluator, corpus: List[Dict]):
        self.evaluator    = evaluator
        self.corpus       = corpus
        self.corpus_by_id = {v["id"]: v for v in corpus}
    
    def analyze_failures(
        self,
        retrieval_results: List[List[Tuple[str, float]]],
        query_ids: List[str],
        queries: Dict[str, str],
        relevant_docs: Dict[str, set],
    ) -> Tuple[pd.DataFrame, pd.DataFrame]:
        
        failures, successes = [], []
        
        for qid, results in zip(query_ids, retrieval_results):
            relevant      = relevant_docs.get(qid, set())
            retrieved_ids = [d for d, _ in results]
            
            correct_rank = next(
                (rank for rank, did in enumerate(retrieved_ids, 1)
                 if did in relevant),
                None
            )
            
            expected_id = list(relevant)[0] if relevant else None
            expected_v  = self.corpus_by_id.get(expected_id, {})
            top1_id     = retrieved_ids[0] if retrieved_ids else None
            top1_v      = self.corpus_by_id.get(top1_id, {})
            
            record = {
                "query_id":        qid,
                "query":           queries[qid],
                "expected_id":     expected_id,
                "expected_chapter":expected_v.get("chapter"),
                "top1_id":         top1_id,
                "top1_chapter":    top1_v.get("chapter"),
                "top1_score":      results[0][1] if results else 0,
                "correct_rank":    correct_rank,
                "success_at_1":    correct_rank == 1,
                "success_at_3":    correct_rank is not None and correct_rank <= 3,
                "success_at_5":    correct_rank is not None and correct_rank <= 5,
            }
            
            if correct_rank == 1:
                successes.append(record)
            else:
                if expected_v.get("chapter") == top1_v.get("chapter"):
                    record["failure_type"] = "same_chapter_confusion"
                elif set(expected_v.get("themes", [])) & set(top1_v.get("themes", [])):
                    record["failure_type"] = "theme_confusion"
                else:
                    record["failure_type"] = "wrong_retrieval"
                failures.append(record)
        
        total = len(failures) + len(successes)
        print(f"\n{'='*65}")
        print(f"📊 Error Analysis Report")
        print(f"{'='*65}")
        print(f"  Total queries:  {total}")
        print(f"  Success @1:     {len(successes)}  ({100*len(successes)/total:.1f}%)")
        print(f"  Failure @1:     {len(failures)}  ({100*len(failures)/total:.1f}%)")
        
        df_fail = pd.DataFrame(failures)
        df_succ = pd.DataFrame(successes)
        
        if len(df_fail) > 0 and "failure_type" in df_fail.columns:
            print(f"\n  Failure breakdown:")
            for ft, cnt in df_fail["failure_type"].value_counts().items():
                print(f"    {ft}: {cnt}  ({100*cnt/len(df_fail):.1f}%)")
        
        all_records = failures + successes
        df_all = pd.DataFrame(all_records)
        for k in [1, 3, 5]:
            col = f"success_at_{k}"
            if col in df_all.columns:
                print(f"\n  Recall@{k}: {df_all[col].mean():.4f}")
        
        return df_fail, df_succ
    
    def plot_rank_distribution(
        self,
        retrieval_results: List[List[Tuple[str, float]]],
        query_ids: List[str],
        relevant_docs: Dict[str, set],
        model_name: str = "Model",
    ):
        ranks, not_found = [], 0
        
        for qid, results in zip(query_ids, retrieval_results):
            relevant      = relevant_docs.get(qid, set())
            retrieved_ids = [d for d, _ in results]
            found = False
            for rank, did in enumerate(retrieved_ids, 1):
                if did in relevant:
                    ranks.append(rank)
                    found = True
                    break
            if not found:
                not_found += 1
        
        fig, axes = plt.subplots(1, 2, figsize=(14, 5))
        
        # Rank histogram
        ax = axes[0]
        if ranks:
            ax.hist(ranks, bins=range(1, max(ranks) + 2),
                    color='#4ECDC4', edgecolor='black', alpha=0.8, align='left')
        for xv, label, c in [(1, 'Rank 1', 'green'),
                              (3, 'Rank 3', 'orange'),
                              (5, 'Rank 5', 'red')]:
            ax.axvline(x=xv, color=c, linestyle='--', label=label, linewidth=2)
        ax.set_xlabel('Rank of Correct Answer', fontsize=12)
        ax.set_ylabel('Count', fontsize=12)
        ax.set_title(f'{model_name}\nRank Distribution', fontsize=12, fontweight='bold')
        ax.legend(fontsize=10)
        ax.grid(alpha=0.3)
        
        # Cumulative recall
        ax    = axes[1]
        total = len(ranks) + not_found
        kvs   = list(range(1, 12))
        cum   = [sum(1 for r in ranks if r <= k) / total for k in kvs]
        ax.plot(kvs, cum, 'o-', color='#4ECDC4', linewidth=2.5, markersize=8)
        ax.fill_between(kvs, 0, cum, alpha=0.2, color='#4ECDC4')
        ax.set_xlabel('K', fontsize=12)
        ax.set_ylabel('Recall@K', fontsize=12)
        ax.set_title(f'{model_name}\nCumulative Recall@K', fontsize=12, fontweight='bold')
        ax.set_xticks(kvs)
        ax.set_ylim(0, 1.05)
        ax.grid(alpha=0.3)
        
        plt.tight_layout()
        safe = model_name.lower().replace(" ", "_")
        plt.savefig(f'rank_dist_{safe}.png', dpi=150, bbox_inches='tight')
        plt.show()
        print(f"  Not found in top-10: {not_found}/{total} ({100*not_found/total:.1f}%)")


