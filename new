    # ── compute aggregate improvements ──
    k_vals   = [1, 3, 5, 10]
    prefixes = ["Recall", "MRR", "nDCG", "Precision"]
    
    improvements = {}
    for p in prefixes:
        for k in k_vals:
            key = f"{p}@{k}"
            improvements[key] = (
                finetuned_metrics.get(key, 0) - baseline_metrics.get(key, 0)
            )
    
    avg_improvement = np.mean(list(improvements.values()))
    best_metric_key = max(improvements, key=lambda x: improvements[x])
    best_improvement = improvements[best_metric_key]
    
    # ── chapter coverage ──
