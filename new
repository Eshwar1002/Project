class RetrievalEvaluator:
    """
    Comprehensive retrieval evaluation.
    
    Metrics: Recall@K, MRR@K, nDCG@K, Precision@K
    Also: qualitative analysis, error analysis, embedding visualisation.
    """
    
    def __init__(
        self,
        model: SentenceTransformer,
        corpus: List[Dict],
        queries: Dict[str, str],
        relevant_docs: Dict[str, set],
        include_sanskrit: bool = True,
    ):
        self.model         = model
        self.raw_corpus    = corpus
        self.queries       = queries
        self.relevant_docs = relevant_docs
        self.corpus_by_id  = {v["id"]: v for v in corpus}
        self.include_sanskrit = include_sanskrit
        
        self.corpus_ids   = [v["id"] for v in corpus]
        self.corpus_texts = [self._get_doc_text(vid) for vid in self.corpus_ids]
        
    def _get_doc_text(self, verse_id: str) -> str:
        v = self.corpus_by_id.get(verse_id, {})
        if not v:
            return ""
        parts = []
        if self.include_sanskrit:
            parts.append(v.get("sanskrit", ""))
        parts.append(v.get("transliteration", ""))
        parts.append(v.get("translation", ""))
        themes = v.get("themes", [])
        if themes:
            parts.append(f"Topics: {', '.join(themes)}")
        return " | ".join(filter(None, parts))
    
    def encode_corpus(self, batch_size: int = 32) -> np.ndarray:
        print("⏳ Encoding corpus...")
        emb = self.model.encode(
            self.corpus_texts,
            batch_size=batch_size,
            show_progress_bar=True,
            convert_to_numpy=True,
            normalize_embeddings=True,
        )
        print(f"✅ Corpus encoded: {emb.shape}")
        return emb
    
    def encode_queries(
        self,
        query_texts: List[str],
        batch_size: int = 32
    ) -> np.ndarray:
        return self.model.encode(
            query_texts,
            batch_size=batch_size,
            show_progress_bar=False,
            convert_to_numpy=True,
            normalize_embeddings=True,
        )
    
    def build_faiss_index(self, corpus_emb: np.ndarray) -> faiss.Index:
        dim   = corpus_emb.shape[1]
        index = faiss.IndexFlatIP(dim)   # cosine sim with L2-normalised vecs
        index.add(corpus_emb.astype(np.float32))
        print(f"✅ FAISS index built: {index.ntotal} vectors")
        return index
    
    def retrieve(
        self,
        query_emb: np.ndarray,
        index: faiss.Index,
        top_k: int = 10
    ) -> List[List[Tuple[str, float]]]:
        scores, indices = index.search(query_emb.astype(np.float32), top_k)
        results = []
        for score_row, idx_row in zip(scores, indices):
            doc_results = [
                (self.corpus_ids[idx], float(score))
                for score, idx in zip(score_row, idx_row)
                if idx >= 0
            ]
            results.append(doc_results)
        return results
    
    def compute_metrics(
        self,
        retrieval_results: List[List[Tuple[str, float]]],
        query_ids: List[str],
        k_values: List[int] = [1, 3, 5, 10]
    ) -> Dict:
        """
        Compute Recall@K, Precision@K, MRR@K, nDCG@K.
        """
        metrics: Dict[str, List[float]] = {}
        for k in k_values:
            for m in ["Recall", "Precision", "MRR", "nDCG"]:
                metrics[f"{m}@{k}"] = []
        
        for qid, retrieved in zip(query_ids, retrieval_results):
            relevant      = self.relevant_docs.get(qid, set())
            retrieved_ids = [doc_id for doc_id, _ in retrieved]
            
            for k in k_values:
                top_k = retrieved_ids[:k]
                hits  = len(set(top_k) & relevant)
                
                # Recall@K
                metrics[f"Recall@{k}"].append(
                    hits / len(relevant) if relevant else 0.0
                )
                # Precision@K
                metrics[f"Precision@{k}"].append(hits / k if k > 0 else 0.0)
                
                # MRR@K
                mrr = 0.0
                for rank, doc_id in enumerate(top_k, 1):
                    if doc_id in relevant:
                        mrr = 1.0 / rank
                        break
                metrics[f"MRR@{k}"].append(mrr)
                
                # nDCG@K
                dcg, ideal_dcg = 0.0, 0.0
                for rank, doc_id in enumerate(top_k, 1):
                    if doc_id in relevant:
                        dcg += 1.0 / np.log2(rank + 1)
                for rank in range(1, min(len(relevant), k) + 1):
                    ideal_dcg += 1.0 / np.log2(rank + 1)
                metrics[f"nDCG@{k}"].append(dcg / ideal_dcg if ideal_dcg > 0 else 0.0)
        
        return {k: float(np.mean(v)) for k, v in metrics.items()}
    
    def evaluate(
        self,
        name: str = "model",
        k_values: List[int] = [1, 3, 5, 10]
    ) -> Tuple[Dict, List, List, np.ndarray]:
        print(f"\n{'='*60}")
        print(f"📊 Evaluating: {name}")
        print(f"{'='*60}")
        
        corpus_emb = self.encode_corpus()
        
        query_texts = list(self.queries.values())
        query_ids   = list(self.queries.keys())
        query_emb   = self.encode_queries(query_texts)
        
        index   = self.build_faiss_index(corpus_emb)
        results = self.retrieve(query_emb, index, top_k=max(k_values))
        
        metrics = self.compute_metrics(results, query_ids, k_values)
        
        print(f"\n{'─'*40}")
        print(f"{'Metric':<20} {'Score':>10}")
        print(f"{'─'*40}")
        for metric, score in sorted(metrics.items()):
            print(f"  {metric:<18} {score:>10.4f}")
        print(f"{'─'*40}")
        
        return metrics, results, query_ids, corpus_emb
    
    def qualitative_analysis(
        self,
        retrieval_results: List[List[Tuple[str, float]]],
        query_ids: List[str],
        n_examples: int = 5,
    ):
        print(f"\n{'='*60}")
        print("🔍 Qualitative Analysis")
        print(f"{'='*60}")
        
        successful, failures = [], []
        for qid, results in zip(query_ids, retrieval_results):
            relevant = self.relevant_docs.get(qid, set())
            top1     = results[0][0] if results else None
            if top1 in relevant:
                successful.append((qid, results))
            else:
                failures.append((qid, results))
        
        print(f"\n✅ Successful Retrievals (showing {min(3, len(successful))}):")
        for qid, results in successful[:3]:
            relevant = self.relevant_docs.get(qid, set())
            print(f"\n  Query: {self.queries[qid]}")
            print(f"  Expected: {list(relevant)[0]}")
            for i, (doc_id, score) in enumerate(results[:3]):
                hit = "✓" if doc_id in relevant else "✗"
                v   = self.corpus_by_id.get(doc_id, {})
                print(f"    {hit} [{i+1}] {doc_id} (score={score:.3f}): "
                      f"{v.get('translation','')[:80]}...")
        
        print(f"\n❌ Failed Retrievals (showing {min(3, len(failures))}):")
        for qid, results in failures[:3]:
            relevant    = self.relevant_docs.get(qid, set())
            expected_id = list(relevant)[0]
            expected_v  = self.corpus_by_id.get(expected_id, {})
            print(f"\n  Query: {self.queries[qid]}")
            print(f"  Expected: {expected_id}: {expected_v.get('translation','')[:80]}...")
            for i, (doc_id, score) in enumerate(results[:3]):
                hit = "✓" if doc_id in relevant else "✗"
                v   = self.corpus_by_id.get(doc_id, {})
                print(f"    {hit} [{i+1}] {doc_id} (score={score:.3f}): "
