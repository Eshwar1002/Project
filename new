class EmbeddingModelTrainer:
    """
    Fine-tunes a multilingual embedding model for Sanskrit-English retrieval.
    
    Supported losses:
    - MultipleNegativesRankingLoss  (best for retrieval)
    - TripletLoss
    - CosineSimilarityLoss
    
    Base model: multilingual-e5-small (supports 100+ languages)
    """
    
    def __init__(
        self,
        model_name: str = "intfloat/multilingual-e5-small",
        output_dir: str = "./sanskrit-retrieval-model"
    ):
        self.model_name = model_name
        self.output_dir = output_dir
        self.model = None
        
    def load_model(self) -> SentenceTransformer:
        """Load the base model."""
        print(f"⏳ Loading model: {self.model_name}")
        self.model = SentenceTransformer(self.model_name, device=DEVICE)
        print(f"✅ Model loaded!")
        print(f"   Max sequence length: {self.model.max_seq_length}")
        print(f"   Embedding dimension: {self.model.get_sentence_embedding_dimension()}")
        return self.model
    
    def train_with_mnrl(
        self,
        train_examples: List[InputExample],
        ir_queries: Dict,
        ir_corpus: Dict,
        ir_relevant: Dict,
        epochs: int = 3,
        batch_size: int = 16,
        warmup_ratio: float = 0.1,
    ) -> SentenceTransformer:
        """
        Train with MultipleNegativesRankingLoss.
        
        Uses all other items in the batch as in-batch negatives.
        No explicit negative examples needed in train_examples.
        Temperature scaling (scale=20) sharpens the similarity distribution.
        """
        print("\n" + "="*60)
        print("🚀 Training with MultipleNegativesRankingLoss")
        print("="*60)
        
        train_dataloader = DataLoader(
            train_examples,
            shuffle=True,
            batch_size=batch_size,
            drop_last=True,
        )
        
        train_loss = losses.MultipleNegativesRankingLoss(
            model=self.model,
            scale=20.0,
            similarity_fct=util.cos_sim,
        )
        
        evaluator = InformationRetrievalEvaluator(
            queries=ir_queries,
            corpus=ir_corpus,
            relevant_docs=ir_relevant,
            name="sanskrit-retrieval",
            precision_recall_at_k=[1, 3, 5, 10],
            accuracy_at_k=[1, 3, 5, 10],
            ndcg_at_k=[10],
            mrr_at_k=[10],
            show_progress_bar=True,
            batch_size=32,
        )
        
        total_steps  = len(train_dataloader) * epochs
        warmup_steps = int(total_steps * warmup_ratio)
        
        print(f"   Epochs:          {epochs}")
        print(f"   Batch size:      {batch_size}")
        print(f"   Total steps:     {total_steps}")
        print(f"   Warmup steps:    {warmup_steps}")
        print(f"   Train examples:  {len(train_examples)}")
        
        self.model.fit(
            train_objectives=[(train_dataloader, train_loss)],
            evaluator=evaluator,
            epochs=epochs,
            warmup_steps=warmup_steps,
            output_path=self.output_dir,
            evaluation_steps=max(1, total_steps // (epochs * 2)),
            save_best_model=True,
            show_progress_bar=True,
            checkpoint_path=os.path.join(self.output_dir, "checkpoints"),
            checkpoint_save_steps=max(1, total_steps // epochs),
            optimizer_params={'lr': 2e-5},
        )
        
        print(f"\n✅ Training complete! Model saved to: {self.output_dir}")
        return self.model
    
    def train_with_triplet(
        self,
        train_examples: List[InputExample],
        epochs: int = 2,
        batch_size: int = 16,
    ) -> SentenceTransformer:
        """
        Train with TripletLoss.
        Uses explicit (anchor, positive, negative) triplets.
        Margin = 0.5 means pos must be at least 0.5 cosine closer than neg.
        """
        print("\n" + "="*60)
        print("🔺 Training with TripletLoss")
        print("="*60)
        
        train_dataloader = DataLoader(
            train_examples,
            shuffle=True,
            batch_size=batch_size,
        )
        
        train_loss = losses.TripletLoss(
            model=self.model,
            triplet_margin=0.5,
            distance_metric=losses.TripletDistanceMetric.COSINE,
        )
        
        total_steps  = len(train_dataloader) * epochs
        warmup_steps = int(total_steps * 0.1)
        
        print(f"   Epochs:      {epochs}")
        print(f"   Total steps: {total_steps}")
        
        self.model.fit(
            train_objectives=[(train_dataloader, train_loss)],
            epochs=epochs,
            warmup_steps=warmup_steps,
            show_progress_bar=True,
            optimizer_params={'lr': 2e-5},
        )
        
        print(f"\n✅ TripletLoss training complete!")
        return self.model


