    def generate_hard_negatives(
        self,
        pairs: List[Dict],
        corpus: List[Dict]
    ) -> List[Dict]:
        """
        Generate hard negatives using three strategies:
        1. Same chapter, different verse  (chapter-level hard neg)
        2. Similar themes but different specific topic
        3. Fully random negatives (easy negatives for contrast)
        """
        corpus_by_id = {v["id"]: v for v in corpus}
        corpus_by_chapter = {}
        for v in corpus:
            ch = v["chapter"]
            if ch not in corpus_by_chapter:
                corpus_by_chapter[ch] = []
            corpus_by_chapter[ch].append(v["id"])
        
        triplets = []
        
        for pair in pairs:
            pos_id = pair["positive_id"]
            if pos_id not in corpus_by_id:
                continue
                
            pos_verse = corpus_by_id[pos_id]
            pos_themes = set(pos_verse.get("themes", []))
            
            # Strategy 1: Same chapter hard negative
            same_chapter_ids = [
                vid for vid in corpus_by_chapter.get(pos_verse["chapter"], [])
                if vid != pos_id
            ]
            
            # Strategy 2: Different chapter, overlapping themes (partial theme confusion)
            theme_overlap_ids = []
            for v in corpus:
                if v["id"] == pos_id:
                    continue
                v_themes = set(v.get("themes", []))
                overlap = len(pos_themes & v_themes)
                if 1 <= overlap <= 2:  # Some but not full overlap = hard neg
                    theme_overlap_ids.append(v["id"])
            
            # Strategy 3: Random negatives
            all_ids = [v["id"] for v in corpus if v["id"] != pos_id]
            random_neg_ids = random.sample(all_ids, min(3, len(all_ids)))
            
            # Combine strategies
            neg_candidates = []
            if same_chapter_ids:
                neg_candidates.extend(random.sample(
                    same_chapter_ids,
                    min(1, len(same_chapter_ids))
                ))
            if theme_overlap_ids:
                neg_candidates.extend(random.sample(
                    theme_overlap_ids,
                    min(1, len(theme_overlap_ids))
                ))
            neg_candidates.extend(random.sample(random_neg_ids, min(1, len(random_neg_ids))))
            
            for neg_id in neg_candidates[:2]:  # Max 2 negatives per query
                triplets.append({
                    "query": pair["query"],
                    "positive_id": pos_id,
                    "negative_id": neg_id,
                    "query_type": pair["query_type"],
                    "neg_strategy": (
                        "hard" if neg_id in same_chapter_ids or neg_id in theme_overlap_ids
                        else "random"
                    )
                })
        
        return triplets


