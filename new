class RetrievalDataset:
    """
    Converts triplets to SentenceTransformers InputExample format.
    Creates both train and eval splits.
    """
    
    def __init__(
        self,
        triplets: List[Dict],
        corpus: List[Dict],
        train_ratio: float = 0.8
    ):
        self.corpus_by_id = {v["id"]: v for v in corpus}
        
        # Shuffle and split
        shuffled = triplets.copy()
        random.shuffle(shuffled)
        
        split_idx = int(len(shuffled) * train_ratio)
        self.train_triplets = shuffled[:split_idx]
        self.eval_triplets  = shuffled[split_idx:]
        
        print(f"📊 Train triplets: {len(self.train_triplets)}")
        print(f"📊 Eval  triplets: {len(self.eval_triplets)}")
    
    def get_document_text(
        self,
        verse_id: str,
        include_sanskrit: bool = True
    ) -> str:
        """
        Returns a rich representation of a verse.
        Combines Sanskrit + transliteration + English + themes.
        """
        v = self.corpus_by_id.get(verse_id, {})
        if not v:
            return ""
        
        parts = []
        if include_sanskrit:
            parts.append(v.get("sanskrit", ""))
        parts.append(v.get("transliteration", ""))
        parts.append(v.get("translation", ""))
        themes = v.get("themes", [])
        if themes:
            parts.append(f"Topics: {', '.join(themes)}")
        
        return " | ".join(filter(None, parts))
    
    def to_input_examples(
        self,
        split: str = "train",
        loss_type: str = "triplet"
    ) -> List[InputExample]:
        """
        Convert to SentenceTransformers InputExample format.
        
        loss_type options:
        - "triplet"  → (anchor, positive, negative)
        - "cosine"   → (text_a, text_b, score)
        - "mnrl"     → (query, positive)   [in-batch negatives]
        """
        triplets_split = (
            self.train_triplets if split == "train" else self.eval_triplets
        )
        examples = []
        
        for t in triplets_split:
            query    = t["query"]
            pos_text = self.get_document_text(t["positive_id"])
            neg_text = self.get_document_text(t["negative_id"])
            
            if not pos_text or not neg_text:
                continue
            
            if loss_type == "triplet":
                examples.append(InputExample(texts=[query, pos_text, neg_text]))
            elif loss_type == "cosine":
                examples.append(InputExample(texts=[query, pos_text], label=1.0))
                examples.append(InputExample(texts=[query, neg_text], label=0.0))
            elif loss_type == "mnrl":
                examples.append(InputExample(texts=[query, pos_text]))
        
        return examples
    
    def get_ir_evaluator_data(self) -> Tuple[Dict, Dict, Dict]:
        """
        Returns data for InformationRetrievalEvaluator.
        
        Returns:
            queries:       {qid: query_text}
            corpus:        {doc_id: doc_text}
            relevant_docs: {qid: set(doc_ids)}
        """
        queries = {}
        relevant_docs = {}
        
        for i, t in enumerate(self.eval_triplets):
            qid = f"q_{i}"
            queries[qid]       = t["query"]
            relevant_docs[qid] = {t["positive_id"]}
        
        corpus_dict = {
            verse["id"]: self.get_document_text(verse["id"])
            for verse in raw_corpus
        }
        
        return queries, corpus_dict, relevant_docs


