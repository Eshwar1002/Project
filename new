        best  = max(b_val, m_val, t_val)
        
        fmt = lambda v: f"{'*' if v == best else ' '}{v:.4f}"
        print(f"  {key:<18} {fmt(b_val):>12} {fmt(m_val):>12} {fmt(t_val):>12}")

