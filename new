Cell 12: Mini RAG Demo
class SanskritRAGSystem:
    """
    Retrieval-Augmented Generation demo for Sanskrit-English queries.
    
    Pipeline:
      Query → Embed → FAISS Retrieve → Format context
    
    In a production system the formatted context would be passed
    to an LLM (LLaMA-3, Mistral, etc.) for generation.
    """
    
    def __init__(
        self,
        model: SentenceTransformer,
        corpus: List[Dict],
        top_k: int = 3,
    ):
        self.model        = model
        self.corpus       = corpus
        self.corpus_by_id = {v["id"]: v for v in corpus}
        self.top_k        = top_k
        
        print("⏳ Building RAG retrieval index...")
        self._build_index()
        print("✅ RAG system ready!")
    
    def _get_doc_text(self, verse: Dict) -> str:
        return " | ".join(filter(None, [
            verse.get("sanskrit", ""),
            verse.get("transliteration", ""),
            verse.get("translation", ""),
            f"Themes: {', '.join(verse.get('themes', []))}",
        ]))
    
    def _build_index(self):
        self.corpus_ids   = [v["id"] for v in self.corpus]
        self.corpus_texts = [self._get_doc_text(v) for v in self.corpus]
        self.corpus_emb   = self.model.encode(
            self.corpus_texts, normalize_embeddings=True,
            show_progress_bar=False,
        )
        dim        = self.corpus_emb.shape[1]
        self.index = faiss.IndexFlatIP(dim)
        self.index.add(self.corpus_emb.astype(np.float32))
    
    def retrieve(self, query: str) -> List[Dict]:
        q_emb          = self.model.encode(
            [query], normalize_embeddings=True, show_progress_bar=False
        )
        scores, indices = self.index.search(q_emb.astype(np.float32), self.top_k)
        
        results = []
        for score, idx in zip(scores[0], indices[0]):
            if idx >= 0:
                v = self.corpus[idx].copy()
                v["retrieval_score"] = float(score)
                results.append(v)
        return results
    
    def format_response(self, query: str, verses: List[Dict]) -> str:
        all_themes = []
        for v in verses:
            all_themes.extend(v.get("themes", []))
        unique_themes = list(dict.fromkeys(all_themes))[:5]  # preserve order
        chapters      = sorted({v["chapter"] for v in verses})
        
        lines = [
            "",
            "╔══════════════════════════════════════════════════════════════╗",
            "║         SANSKRIT-ENGLISH RETRIEVAL SYSTEM (RAG Demo)        ║",
            "╚══════════════════════════════════════════════════════════════╝",
            "",
            f"📝 QUERY: {query}",
            "",
            "="*65,
            f"📚 RETRIEVED PASSAGES (Top-{len(verses)}):",
            "="*65,
        ]
        
        for i, v in enumerate(verses, 1):
            lines += [
                "",
                "┌" + "─"*63 + "┐",
                f"│ Result #{i}  │  {v['id']}  │  "
                f"Chapter {v['chapter']}, Verse {v['verse']}  │  "
                f"Score: {v['retrieval_score']:.3f}",
                "├" + "─"*63 + "┤",
                f"│ 🕉️  SANSKRIT:",
                f"│   {v.get('sanskrit','')[:100]}...",
                f"│",
                f"│ 🔤 TRANSLITERATION:",
                f"│   {v.get('transliteration','')[:100]}...",
                f"│",
                f"│ 📖 TRANSLATION:",
                f"│   {v.get('translation','')}",
                f"│",
                f"│ 🏷️  THEMES: {', '.join(v.get('themes', []))}",
                "└" + "─"*63 + "┘",
            ]
        
        lines += [
            "",
            "="*65,
            "💡 CONTEXTUAL SUMMARY:",
            f"   Query covers themes: {', '.join(unique_themes)}",
            f"   Relevant chapters:   {chapters}",
            "",
            "   ➡  In a full RAG pipeline these passages would be passed",
            "      as context to an LLM to generate a grounded answer.",
            "="*65,
            "",
        ]
        return "\n".join(lines)
    
    def query(self, question: str) -> str:
        return self.format_response(question, self.retrieve(question))


