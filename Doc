  "mnrl": { ... },
  "triplet": { ... },
  "improvements": {
    "Recall@1": +0.xxxx, "MRR@10": +0.xxxx, ...
  },
  "config": {
    "seed": 42,
    "base_model": "intfloat/multilingual-e5-small",
    "corpus_size": 44,
    "training_pairs": 1234,
    "triplets": 2468,
    "mnrl_epochs": 3,
    "triplet_epochs": 2,
    "batch_size": 16,
    "learning_rate": 0.00002,
    "embedding_dim": 384
