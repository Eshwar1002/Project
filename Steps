def format_alpaca_prompt(example: Dict) -> str:
    """
    Format example into Alpaca-style instruction prompt.
    
    We use the Alpaca format because:
    1. It's simple and widely supported
    2. Works well with instruction-tuned models
    3. Clear separation of instruction / input / response
    """
    if example.get("input", "").strip():
        prompt = (
            "### Instruction:\n"
            f"{example['instruction']}\n\n"
            "### Input:\n"
            f"{example['input']}\n\n"
            "### Response:\n"
            f"{example['output']}"
        )
    else:
        prompt = (
            "### Instruction:\n"
            f"{example['instruction']}\n\n"
            "### Response:\n"
            f"{example['output']}"
        )
    return prompt


def format_inference_prompt(instruction: str, input_text: str = "") -> str:
    """Format prompt for inference (no response field)."""
    if input_text.strip():
        return (
            "### Instruction:\n"
            f"{instruction}\n\n"
            "### Input:\n"
            f"{input_text}\n\n"
            "### Response:\n"
        )
    return (
        "### Instruction:\n"
        f"{instruction}\n\n"
        "### Response:\n"
    )


