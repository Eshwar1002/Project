# ── Cell 5: Extended Dataset from Parallel Corpora ──────────
# Load OPUS Sanskrit-English data from HuggingFace

def load_opus_sanskrit(max_samples: int = 500) -> List[Dict]:
    """Load Sanskrit-English parallel data from OPUS via HuggingFace."""
    examples = []
    
    try:
        # Try loading iitb dataset (Hindi proxy if Sanskrit not available)
        ds = load_dataset(
            "Helsinki-NLP/opus-100",
            "en-hi",  # fallback: use Hindi as similar Devanagari script
            split="train",
            streaming=True,
            trust_remote_code=True,
        )
        
        instructions_san2eng = [
            "Translate the following Sanskrit/Devanagari text to English.",
            "What is the English translation of this text?",
            "Convert this text to English.",
            "Provide an English translation.",
        ]
        
        for i, item in enumerate(ds):
            if i >= max_samples:
                break
            
            src = item["translation"].get("hi", "").strip()
            tgt = item["translation"].get("en", "").strip()
            
            if len(src) < 10 or len(tgt) < 10:
                continue
                
            examples.append({
                "instruction": instructions_san2eng[i % len(instructions_san2eng)],
                "input": src,
                "output": tgt,
                "task": "san2eng",
            })
        
        print(f"✅ Loaded {len(examples)} OPUS parallel examples")
    except Exception as e:
        print(f"⚠️  OPUS loading failed: {e}")
        print("   Continuing with seed examples only.")
    
    return examples


def load_huggingface_sanskrit() -> List[Dict]:
    """Try loading any Sanskrit-specific datasets from HuggingFace."""
    examples = []
    
    # Attempt multiple datasets
    candidates = [
        ("rahular/itihasa", None),
        ("setu-datacomp/sangraha-cultural", None),
    ]
    
    for dataset_name, config in candidates:
        try:
            ds = load_dataset(
                dataset_name,
                config,
                split="train",
                streaming=True,
                trust_remote_code=True,
            )
            count = 0
            for item in ds:
                if count >= 100:
                    break
                # Extract text fields generically
                text = ""
                for key in ["text", "content", "sanskrit", "devanagari"]:
                    if key in item and item[key]:
                        text = str(item[key]).strip()
                        break
                
                if len(text) > 20:
                    examples.append({
                        "instruction": "Explain or translate the following Sanskrit text.",
                        "input": text[:500],
                        "output": f"This is Sanskrit text: {text[:200]}...",
                        "task": "explanation",
                    })
                    count += 1
            
            print(f"✅ {dataset_name}: {count} examples")
        except Exception as e:
            print(f"   {dataset_name}: {e}")
    
    return examples


# Build the extended dataset
print("Building dataset...")
opus_examples      = load_opus_sanskrit(max_samples=300)
hf_examples        = load_huggingface_sanskrit()
all_examples       = SEED_EXAMPLES + opus_examples + hf_examples

print(f"\n📊 Dataset Summary:")
print(f"   Seed examples : {len(SEED_EXAMPLES)}")
print(f"   OPUS examples : {len(opus_examples)}")
print(f"   HF examples   : {len(hf_examples)}")
print(f"   Total         : {len(all_examples)}")
print(f"   Tasks         : {Counter(e['task'] for e in all_examples)}")
