def analyze_tokenization(text: str, label: str = "") -> Dict:
    """Detailed tokenization analysis for a given text."""
    tokens    = tokenizer.encode(text, add_special_tokens=False)
    decoded   = [tokenizer.decode([t]) for t in tokens]
    
    # Count Devanagari characters
    deva_chars = sum(1 for c in text if '\u0900' <= c <= '\u097F')
    
    return {
        "label"        : label,
        "text"         : text,
        "n_chars"      : len(text),
        "n_tokens"     : len(tokens),
        "tokens"       : decoded,
        "deva_chars"   : deva_chars,
        "chars_per_tok": len(text) / max(len(tokens), 1),
        "tokens"       : decoded[:20],  # first 20
    }


# Test texts
