    if tokenizer.pad_token is None:
        tokenizer.pad_token     = tokenizer.eos_token
        tokenizer.pad_token_id  = tokenizer.eos_token_id
    
    print(f"Loading model with 4-bit quantization...")
    bnb_config = get_bnb_config()
    
    model = AutoModelForCausalLM.from_pretrained(
        model_id,
        quantization_config = bnb_config,
        device_map          = "auto",
        trust_remote_code   = True,
        torch_dtype         = torch.float16,
        attn_implementation = "eager",  # "flash_attention_2" if installed
    )
    
    # Prepare model for k-bit training
    # This: 1) casts layer norms to fp32
    #       2) enables gradient checkpointing
    #       3) makes input embeddings require grad
    model = prepare_model_for_kbit_training(
        model,
        use_gradient_checkpointing=True,
    )
    
    # Apply LoRA
