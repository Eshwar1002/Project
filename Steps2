def run_translation_metrics(asst, pairs: List[Dict]) -> Dict:
    """
    Compute BLEU, chrF, and ROUGE on held-out translation pairs.
    Uses sacrebleu 2.x API throughout.
    """
    instruction = "Translate the following Sanskrit text to English."

    # Generate or use mock predictions
    if asst is not None:
        print("Generating translations...")
        predictions: List[str] = []
        for pair in pairs:
            pred = asst.ask(instruction, pair["sanskrit"], verbose=False)
            predictions.append(pred)
            short = pair["sanskrit"][:30]
            print(f"  {short:<32} -> {pred[:50]}...")
    else:
        # Realistic mock translations
        predictions = [
            "Knowledge bestows humility and wisdom upon the seeker",
            "May all beings everywhere be happy and free from suffering",
            "Non-violence is the highest duty and supreme dharma",
            "Knowledge is the supreme strength and ultimate power",
            "Lead me from darkness to light and from ignorance to knowledge",
            "Speak the truth and walk always in righteousness",
        ]
        print("Using mock predictions (model not loaded).")

    primary_refs = [p["reference"] for p in pairs]

    # Build reference lists for multi-ref BLEU
    # sacrebleu.corpus_bleu expects List[List[str]] — one list per reference
    max_refs = max(1 + len(p.get("alt_refs", [])) for p in pairs)
    ref_matrix: List[List[str]] = []
    for i in range(max_refs):
        col = []
        for p in pairs:
            all_r = [p["reference"]] + p.get("alt_refs", [])
            col.append(all_r[i] if i < len(all_r) else all_r[0])
        ref_matrix.append(col)

    # ── BLEU ──────────────────────────────────────────────
    bleu_single = sacrebleu_lib.corpus_bleu(
        predictions, [primary_refs], tokenize="intl"
    )
    bleu_multi  = sacrebleu_lib.corpus_bleu(
        predictions, ref_matrix, tokenize="intl"
    )

    # ── chrF (sacrebleu 2.x API) ──────────────────────────
    # corpus_chrf signature: (hypotheses, references)
    # references must be List[List[str]] in sacrebleu >= 2.0
    chrf_score = sacrebleu_lib.corpus_chrf(
        predictions, ref_matrix
    )

    # ── ROUGE ─────────────────────────────────────────────
    rscorer = rouge_scorer_lib.RougeScorer(
        ["rouge1", "rouge2", "rougeL"], use_stemmer=False
    )
    rouge_agg: Dict[str, List[float]] = {
        "rouge1": [], "rouge2": [], "rougeL": []
    }
    for pred, ref in zip(predictions, primary_refs):
        s = rscorer.score(ref, pred)
        for k in rouge_agg:
            rouge_agg[k].append(s[k].fmeasure)

    rouge_avg = {k: float(np.mean(v)) for k, v in rouge_agg.items()}

    # ── Per-example sentence BLEU ─────────────────────────
    per_bleu: List[float] = []
    for pred, p in zip(predictions, pairs):
        all_r = [p["reference"]] + p.get("alt_refs", [])
        b = sacrebleu_lib.sentence_bleu(pred, all_r, smooth_method="floor")
        per_bleu.append(b.score)

    # ── Report ─────────────────────────────────────────────
    print("\n" + "=" * 55)
    print("TRANSLATION METRICS")
    print("=" * 55)
    print(f"  BLEU (1 ref)  : {bleu_single.score:.2f}")
    print(f"  BLEU (multi)  : {bleu_multi.score:.2f}")
    print(f"  chrF++        : {chrf_score.score:.2f}")
    print(f"  ROUGE-1       : {rouge_avg['rouge1']:.3f}")
    print(f"  ROUGE-2       : {rouge_avg['rouge2']:.3f}")
    print(f"  ROUGE-L       : {rouge_avg['rougeL']:.3f}")

    print(f"\nPer-Example BLEU:")
    print(f"  {'Sanskrit':<35} {'BLEU':>6}")
    print(f"  {'─'*35} {'─'*6}")
    for pair, b in zip(pairs, per_bleu):
        print(f"  {pair['sanskrit'][:33]:<35} {b:>6.1f}")

    print(f"""
Interpretation:
  BLEU 0-10   = very poor
  BLEU 10-20  = understandable but poor
  BLEU 20-30  = reasonable
  BLEU 30+    = good

  Sanskrit BLEU is systematically lower than European language BLEU
  because many valid English translations exist per verse.
  chrF++ is more reliable for morphologically rich languages.
""")

    return {
        "bleu_single": float(bleu_single.score),
        "bleu_multi" : float(bleu_multi.score),
        "chrf"       : float(chrf_score.score),
        "rouge1"     : rouge_avg["rouge1"],
        "rouge2"     : rouge_avg["rouge2"],
        "rougeL"     : rouge_avg["rougeL"],
        "per_example": list(zip(
            [p["sanskrit"]  for p in pairs],
            predictions,
