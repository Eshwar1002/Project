def plot_training_curves(tr, out_dir: str):
    """Plot train/val loss and learning-rate schedule."""

    fig, axes = plt.subplots(1, 2, figsize=(14, 5))
    fig.suptitle(
        "Sanskrit-English LLM Fine-Tuning — Training Curves",
        fontsize=13, fontweight="bold",
    )

    # ── Extract log history ───────────────────────────────
    train_steps, train_losses = [], []
    eval_steps,  eval_losses  = [], []
    lr_steps,    lr_values    = [], []

    if tr is not None and hasattr(tr, "state"):
        for entry in tr.state.log_history:
            step = entry.get("step", 0)
            if "loss" in entry and "eval_loss" not in entry:
                train_steps.append(step)
                train_losses.append(entry["loss"])
            if "eval_loss" in entry:
                eval_steps.append(step)
                eval_losses.append(entry["eval_loss"])
            if "learning_rate" in entry:
                lr_steps.append(step)
                lr_values.append(entry["learning_rate"])

    use_mock = len(train_losses) == 0

    if use_mock:
        # Simulate realistic curves
        np.random.seed(42)
        total   = 55
        warmup  = 2
        s       = np.arange(total)
        noise_t = np.random.normal(0, 0.03, total)
        noise_e = np.random.normal(0, 0.02, 6)

        train_losses = list(2.8 * np.exp(-s / 18) + 0.55 + noise_t)
        train_losses = [max(x, 0.45) for x in train_losses]
        train_steps  = list(range(total))

        es = [0, 10, 20, 30, 40, total - 1]
        eval_losses  = list(2.6 * np.exp(-np.array(es) / 18) + 0.65 + noise_e)
        eval_losses  = [max(x, 0.55) for x in eval_losses]
        eval_steps   = es

        lr_values = list(np.where(
            s < warmup,
            2e-4 * s / warmup,
            2e-4 * 0.5 * (1 + np.cos(np.pi * (s - warmup) / (total - warmup)))
        ))
        lr_steps = list(range(total))

    # ── Plot 1: Loss ──────────────────────────────────────
    ax1 = axes[0]
    ax1.plot(train_steps, train_losses,
             color="#2196F3", lw=2, label="Train Loss")
    if eval_losses:
        ax1.plot(eval_steps, eval_losses,
                 color="#F44336", lw=2, ls="--",
                 marker="o", ms=4, label="Val Loss")
    ax1.set_xlabel("Training Steps")
    ax1.set_ylabel("Loss")
    title_suffix = " (Simulated)" if use_mock else ""
    ax1.set_title(f"Training & Validation Loss{title_suffix}")
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    ax1.set_ylim(bottom=0)

    summary_text = (
        f"Train: {train_losses[0]:.2f} -> {train_losses[-1]:.2f}\n"
        f"Val:   {eval_losses[0]:.2f} -> {eval_losses[-1]:.2f}"
    ) if eval_losses else (
        f"Train: {train_losses[0]:.2f} -> {train_losses[-1]:.2f}"
    )
    ax1.text(
        0.60, 0.85, summary_text,
        transform=ax1.transAxes, fontsize=9,
        bbox=dict(boxstyle="round", facecolor="wheat", alpha=0.5),
    )

    # ── Plot 2: Learning rate ─────────────────────────────
    ax2 = axes[1]
    lr_scaled = [v * 1e4 for v in lr_values]
    ax2.plot(lr_steps, lr_scaled, color="#4CAF50", lw=2)
    ax2.fill_between(lr_steps, lr_scaled, alpha=0.15, color="#4CAF50")
    ax2.set_xlabel("Training Steps")
    ax2.set_ylabel("Learning Rate (x1e-4)")
    ax2.set_title("Cosine LR Schedule with Warmup")
    ax2.grid(True, alpha=0.3)

    plt.tight_layout()
    save_path = os.path.join(out_dir, "training_curves.png")
    plt.savefig(save_path, dpi=150, bbox_inches="tight")
    print(f"Saved: {save_path}")
