def format_alpaca_prompt(example: Dict) -> str:
    """
    Alpaca-style prompt.
    If input is empty we use the no-input template.
    """
    inp = example.get("input", "").strip()
    if inp:
        return (
            "### Instruction:\n"
            f"{example['instruction']}\n\n"
            "### Input:\n"
            f"{inp}\n\n"
            "### Response:\n"
            f"{example['output']}"
        )
    return (
        "### Instruction:\n"
        f"{example['instruction']}\n\n"
        "### Response:\n"
        f"{example['output']}"
    )


def format_inference_prompt(instruction: str, input_text: str = "") -> str:
    """Prompt for inference — response field is empty (model fills it)."""
    if input_text.strip():
        return (
            "### Instruction:\n"
            f"{instruction}\n\n"
            "### Input:\n"
            f"{input_text}\n\n"
            "### Response:\n"
        )
    return (
        "### Instruction:\n"
        f"{instruction}\n\n"
        "### Response:\n"
    )


