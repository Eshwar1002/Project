class SanskritAssistant:
    """
    Inference wrapper for the fine-tuned Sanskrit model.
    Handles prompt formatting, generation, and decoding.
    """

    def __init__(self, mdl, tok):
        self.model     = mdl
        self.tokenizer = tok
        self.model.eval()

        self.gen_config = GenerationConfig(
            max_new_tokens     = 300,
            temperature        = 0.3,
            top_p              = 0.9,
            repetition_penalty = 1.15,
            do_sample          = True,
            pad_token_id       = tok.pad_token_id,
            eos_token_id       = tok.eos_token_id,
        )

    @torch.no_grad()
    def ask(
        self,
        instruction: str,
        input_text : str  = "",
        verbose    : bool = True,
        max_new_tokens: int = 300,
    ) -> str:
        """Generate a response for a single query."""
        prompt = format_inference_prompt(instruction, input_text)

        if verbose:
            print(f"Instruction : {instruction}")
            if input_text:
                short = input_text.replace("\n", " ")[:80]
                print(f"Input       : {short}")
            print("-" * 50)

        inputs = self.tokenizer(
            prompt,
            return_tensors = "pt",
            truncation     = True,
            max_length     = 400,
        ).to(DEVICE)

        # Use autocast only if on CUDA
        ctx = (
            torch.cuda.amp.autocast(dtype=torch.float16)
            if torch.cuda.is_available()
            else torch.no_grad()   # CPU fallback (already in no_grad)
        )

        with ctx:
            output_ids = self.model.generate(
                **inputs,
                generation_config = self.gen_config,
            )

        # Decode only the newly generated tokens
        prompt_len = inputs["input_ids"].shape[1]
        new_ids    = output_ids[0][prompt_len:]
        response   = self.tokenizer.decode(
            new_ids, skip_special_tokens=True
        ).strip()

        if verbose:
            print(response)
            print()

        return response


