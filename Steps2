def run_training(
    mdl,
    tok,
    train_ds: Dataset,
    val_ds:   Dataset,
    out_dir:  str,
):
    """SFT training with completion-only loss masking."""

    if not MODEL_LOADED:
        print("Model not loaded — skipping training.")
        return None, None

    training_args = get_training_args(out_dir)

    # Only compute loss on tokens AFTER '### Response:\n'
    # This prevents the model from over-fitting to prompt tokens.
    response_template = "### Response:\n"

    data_collator = DataCollatorForCompletionOnlyLM(
        response_template = response_template,
        tokenizer         = tok,
        mlm               = False,
    )

    # ── SFTTrainer ────────────────────────────────────────
    # trl==0.8.6: use 'tokenizer' kwarg (not 'processing_class')
    trainer = SFTTrainer(
        model              = mdl,
        args               = training_args,
        train_dataset      = train_ds,
        eval_dataset       = val_ds,
        tokenizer          = tok,
        data_collator      = data_collator,
        dataset_text_field = "text",
        max_seq_length     = 512,
        packing            = False,
    )

    effective_batch = (
        training_args.per_device_train_batch_size
        * training_args.gradient_accumulation_steps
    )
    steps_per_epoch = max(1, len(train_ds) // effective_batch)
    total_steps     = steps_per_epoch * training_args.num_train_epochs

    print(f"Training plan:")
    print(f"  train examples   : {len(train_ds)}")
    print(f"  effective batch  : {effective_batch}")
    print(f"  steps / epoch    : {steps_per_epoch}")
    print(f"  total steps      : {total_steps}")

    # Pre-training eval
    print("\nPre-training evaluation...")
    pre_eval = trainer.evaluate()
    print(f"  Pre-training eval loss: {pre_eval['eval_loss']:.4f}")

    # Train
    print("\nStarting training...")
    t0 = time.time()
    train_result = trainer.train()
    elapsed = time.time() - t0

    print(f"\nTraining complete in {elapsed / 60:.1f} min")
    print(f"  Final train loss : {train_result.training_loss:.4f}")

    # Save adapter to Drive
    print(f"\nSaving adapter to {out_dir}...")
    trainer.save_model(out_dir)
    tok.save_pretrained(out_dir)
    print("  Saved!")

    # Post-training eval
    post_eval = trainer.evaluate()
    print(f"\nResults:")
    print(f"  Pre  eval loss : {pre_eval['eval_loss']:.4f}")
    print(f"  Post eval loss : {post_eval['eval_loss']:.4f}")
    improvement = pre_eval["eval_loss"] - post_eval["eval_loss"]
    print(f"  Improvement    : {improvement:.4f}")

    return trainer, train_result


