    """
    global MODEL_LOADED, ASSISTANT_READY, assistant

    # Check adapter files
    required_files = ["adapter_config.json"]
    weight_files   = [
        "adapter_model.safetensors",
        "adapter_model.bin",
    ]
    missing_config = [
        f for f in required_files
        if not os.path.exists(os.path.join(adapter_path, f))
    ]
    has_weights = any(
        os.path.exists(os.path.join(adapter_path, w))
        for w in weight_files
    )

    if missing_config or not has_weights:
        print(f"Adapter not found in {adapter_path}.")
        print("Missing files:")
        for f in required_files + weight_files:
            full = os.path.join(adapter_path, f)
            status = "OK" if os.path.exists(full) else "MISSING"
            print(f"  [{status}] {f}")
        print("\nYou must re-run training (Cell 10).")
        return None, None

    print("[1/3] Loading tokenizer...")
    tok_reload = AutoTokenizer.from_pretrained(
        adapter_path,
        trust_remote_code=True,
    )
    tok_reload.padding_side = "right"
    if tok_reload.pad_token is None:
        tok_reload.pad_token    = tok_reload.eos_token
        tok_reload.pad_token_id = tok_reload.eos_token_id
    print("      OK")

    print("[2/3] Loading base model (4-bit)...")
