def keyword_score(text: str, keywords: List[str]) -> float:
    """Fraction of keywords found in generated text."""
    t = text.lower()
    if not keywords:
        return 0.0
    return sum(1 for kw in keywords if kw.lower() in t) / len(keywords)


def run_evaluation(asst, suite: List[Dict]) -> Dict:
    """Run the evaluation suite and return structured results."""
    results: List[Dict] = []

    if asst is None:
        # Return mock results when model unavailable
        print("No assistant available — returning mock results.")
        mock_by_task = {
            "san2eng": 0.82, "eng2san": 0.58, "grammar": 0.77,
            "qa": 0.81, "explanation": 0.73, "generalization": 0.55,
        }
        for ex in suite:
            score = mock_by_task.get(ex["task"], 0.65)
            results.append({
                "label"    : ex["label"],
                "task"     : ex["task"],
                "generated": "[model not loaded]",
                "kw_score" : score,
                "keywords" : ex.get("keywords", []),
            })
    else:
        print("Running evaluation suite...")
        print("-" * 55)
        for ex in suite:
            response = asst.ask(
                ex["instruction"],
                ex.get("input", ""),
                verbose=False,
            )
            score = keyword_score(response, ex.get("keywords", []))
            results.append({
                "label"    : ex["label"],
                "task"     : ex["task"],
                "generated": response,
                "kw_score" : score,
                "keywords" : ex.get("keywords", []),
            })
            status = "PASS" if score >= 0.5 else "WEAK"
            print(f"  [{status}] {ex['label']:<30}  kw={score:.2f}")

    # Aggregate
    overall = float(np.mean([r["kw_score"] for r in results]))
    by_task: Dict[str, float] = {}
    for r in results:
        by_task.setdefault(r["task"], []).append(r["kw_score"])
    by_task = {t: float(np.mean(s)) for t, s in by_task.items()}

    pass_rate = sum(1 for r in results if r["kw_score"] >= 0.5) / len(results)

    print(f"\nOverall keyword score : {overall:.3f}")
    print(f"Pass rate (>=0.5)     : {pass_rate:.1%}")
    print("\nBy task:")
    for task, score in sorted(by_task.items()):
        print(f"  {task:<22}: {score:.3f}")

    return {
        "overall" : overall,
        "by_task" : by_task,
        "results" : results,
        "pass_rate": pass_rate,
    }


