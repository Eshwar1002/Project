def check_adapter_toggle_support(mdl) -> bool:
    """
    Check whether the model supports disable/enable_adapter_layers.
    Available in peft >= 0.6.0.
    """
    return (
        hasattr(mdl, "disable_adapter_layers")
        and hasattr(mdl, "enable_adapter_layers")
    )


def compare_base_vs_finetuned(asst, cases: List[Dict]):
    """
    Compare base model (LoRA disabled) vs fine-tuned (LoRA enabled).
    Falls back to documented examples if adapter toggle not supported.
    """

    # Documented fallback outputs
    documented_base = {
        "BG 2.47": (
            "I see Devanagari text. This appears to be Sanskrit and may be "
