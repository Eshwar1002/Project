from datasets import load_dataset

def load_external_data(max_samples: int = 150) -> List[Dict]:
    """
    Load Sanskrit or Hindi parallel data from OPUS.
    Multiple fallbacks — always returns a list (may be empty).
    """
    examples: List[Dict] = []

    instructions = [
        "Translate the following Sanskrit text to English.",
        "What is the English translation of this text?",
        "Convert this Sanskrit text to English.",
        "Provide an English translation of the following.",
    ]

    # ── Attempt 1: Sanskrit directly ─────────────────────
    datasets_to_try = [
        ("Helsinki-NLP/opus-100", "en-sa", "sa", "en"),
        ("Helsinki-NLP/opus-100", "en-hi", "hi", "en"),
    ]

    for ds_name, config, src_key, tgt_key in datasets_to_try:
        if len(examples) >= max_samples:
            break
        try:
            print(f"  Trying {ds_name} ({config})...")
            ds = load_dataset(
                ds_name,
                config,
                split="train",
                streaming=True,
                trust_remote_code=True,
            )
            count = 0
            for item in ds:
                if count >= max_samples:
                    break
                trans = item.get("translation", {})
                src   = trans.get(src_key, "").strip()
                tgt   = trans.get(tgt_key, "").strip()
                # Filter: must have Devanagari and reasonable length
                has_deva = any("\u0900" <= c <= "\u097F" for c in src)
                if has_deva and len(src) >= 10 and len(tgt) >= 10:
                    examples.append({
                        "instruction": instructions[count % len(instructions)],
                        "input"      : src,
                        "output"     : tgt,
                        "task"       : "san2eng",
                    })
                    count += 1
            print(f"  Loaded {count} examples from {config}")
            if count > 0:
                break   # got enough, stop trying
        except Exception as e:
            print(f"  Failed ({config}): {type(e).__name__}: {e}")
            continue

    if not examples:
        print("  All external sources failed — using seed examples only")

    return examples


