def rubric_score(generated: str, expected: Dict) -> Dict:
    """
    Score a response on four dimensions.
    Returns individual and total scores.
    """
    gen = generated.lower()

    # Accuracy (0-3): required concepts present
    required = expected.get("required", [])
    found_r  = sum(1 for c in required if c.lower() in gen)
    accuracy = round(3 * found_r / max(len(required), 1))

    # Completeness (0-3): bonus items present
    bonus    = expected.get("bonus", [])
    found_b  = sum(1 for b in bonus if b.lower() in gen)
    completeness = min(3, found_r + found_b)

    # Structure (0-2): formatting indicators
    structure = min(2, sum([
        "\n"  in generated,
        ":"   in generated,
        len(generated.split()) > 30,
        any(c in generated for c in ["1.", "2.", "-", "•"]),
    ]))

    # No hallucination (0-2): penalise clearly wrong claims
    avoid       = expected.get("avoid", [])
    wrong_found = sum(1 for a in avoid if a.lower() in gen)
    no_halluc   = max(0, 2 - wrong_found * 2)

    total = accuracy + completeness + structure + no_halluc
    return {
        "accuracy"        : accuracy,
        "completeness"    : completeness,
        "structure"       : structure,
        "no_hallucination": no_halluc,
        "total"           : total,
        "pct"             : total / 10.0,
    }


def run_rubric_evaluation(asst, cases: List[Dict]) -> Dict:
