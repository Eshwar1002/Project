    after_kw  = np.mean([r["keyword_score"] for r in after_results])
    
    print(f"\n📊 Keyword Match Score (0-1, higher is better):")
    print(f"   Before fine-tuning : {before_kw:.3f}")
    print(f"   After  fine-tuning : {after_kw:.3f}")
