        count = 0
        for item in ds:
            if count >= max_samples:
                break
            src = item["translation"].get("sa", "").strip()
            tgt = item["translation"].get("en", "").strip()
            if len(src) >= 10 and len(tgt) >= 10:
                examples.append({
                    "instruction": instructions[count % len(instructions)],
                    "input": src,
                    "output": tgt,
