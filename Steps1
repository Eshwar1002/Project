def format_alpaca_prompt(example: Dict) -> str:
    """
    Format as Alpaca-style instruction prompt.
    
    Why Alpaca format:
    - Clear structural separation of instruction/input/response
    - Well-supported by TRL/SFTTrainer
    - Completion-only loss masking works with ### Response: marker
    """
    inp = example.get("input", "").strip()
    if inp:
        return (
            "### Instruction:\n"
            f"{example['instruction']}\n\n"
            "### Input:\n"
            f"{inp}\n\n"
            "### Response:\n"
            f"{example['output']}"
        )
    return (
        "### Instruction:\n"
        f"{example['instruction']}\n\n"
        "### Response:\n"
        f"{example['output']}"
    )


def format_inference_prompt(instruction: str, input_text: str = "") -> str:
    """Prompt for inference — no response content."""
    if input_text.strip():
        return (
            "### Instruction:\n"
            f"{instruction}\n\n"
            "### Input:\n"
            f"{input_text}\n\n"
            "### Response:\n"
        )
    return (
        "### Instruction:\n"
        f"{instruction}\n\n"
        "### Response:\n"
    )


