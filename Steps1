```python
# ============================================================
# CELL 8: QLoRA + LoRA Configuration
# ============================================================

def get_bnb_config() -> BitsAndBytesConfig:
    """
    4-bit NF4 quantization.
    
    NF4 (NormalFloat4) is better than int4 for LLMs because:
    - Weights are normally distributed; NF4 is optimal for this
    - Double quantization saves additional ~0.4 GB
    - bfloat16 compute preserves gradient quality
    """
    return BitsAndBytesConfig(
        load_in_4bit=True,
        bnb_4bit_quant_type="nf4",
        bnb_4bit_compute_dtype=torch.bfloat16,
        bnb_4bit_use_double_quant=True,
    )


def get_lora_config() -> LoraConfig:
    """
    LoRA configuration.
    
    r=16 choice:
    - r=8:  Less expressive, ~8MB adapter — use if OOM
    - r=16: Good balance for domain adaptation — DEFAULT
    - r=32: Better quality, ~32MB — use if you have L4/A100
    
    We target BOTH attention and MLP because:
    - Attention: needs to learn new token relationships for Sanskrit
    - MLP: stores factual knowledge — needs Sanskrit facts
    """
    return LoraConfig(
        r=16,
        lora_alpha=32,        # effective scaling = alpha/r = 2.0
        target_modules=[
            "q_proj", "k_proj", "v_proj", "o_proj",  # attention
            "gate_proj", "up_proj", "down_proj",       # MLP
        ],
        lora_dropout=0.05,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
    )


def get_training_args(output_dir: str) -> TrainingArguments:
    """
    Training args optimized for T4 (16GB).
    
    Effective batch size = per_device × grad_accum = 4 × 8 = 32
    This is standard for SFT on small datasets.
    """
    return TrainingArguments(
        output_dir                  = output_dir,
        num_train_epochs            = 5,
        per_device_train_batch_size = 4,
        per_device_eval_batch_size  = 4,
        gradient_accumulation_steps = 8,     # effective batch = 32
        gradient_checkpointing      = True,  # saves ~40% VRAM
        optim                       = "paged_adamw_32bit",
        learning_rate               = 2e-4,
        weight_decay                = 0.01,
        fp16                        = True,  # T4 supports fp16
        max_grad_norm               = 0.3,
        warmup_ratio                = 0.03,
        lr_scheduler_type           = "cosine",
        logging_steps               = 10,
        eval_strategy               = "steps",
        eval_steps                  = 50,
        save_strategy               = "steps",
        save_steps                  = 100,
        save_total_limit            = 2,
        load_best_model_at_end      = True,
        report_to                   = "none",
        group_by_length             = True,  # reduces padding waste
        seed                        = 42,
    )


