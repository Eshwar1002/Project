        "text"     : text,
        "n_chars"  : len(text),
        "n_tokens" : len(tokens),
        "decoded"  : decoded[:20],
        "deva_chars": sum(1 for c in text if '\u0900' <= c <= '\u097F'),
        "ratio"    : len(text) / max(len(tokens), 1),
    }


