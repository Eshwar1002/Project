# ── Cell 13: Training ────────────────────────────────────────

def run_training(
    model,
    tokenizer,
    train_dataset: Dataset,
    val_dataset:   Dataset,
    output_dir:    str = "./sanskrit-lm-adapter",
):
    """
    Full training run using TRL's SFTTrainer.
    
    Why SFTTrainer over raw Trainer?
    - Handles packing of short sequences (more efficient GPU use)
    - Built-in completion-only loss masking
    - Simpler API for instruction tuning
    """
    
    training_args = get_training_args(output_dir)
    
    # Response template: we only compute loss on the response tokens
    # This is crucial — we don't want to penalize the model for
    # the instruction/input part of the prompt
    response_template = "### Response:\n"
    
    data_collator = DataCollatorForCompletionOnlyLM(
        response_template = response_template,
        tokenizer         = tokenizer,
        mlm               = False,
    )
    
    trainer = SFTTrainer(
        model             = model,
        args              = training_args,
        train_dataset     = train_dataset,
        eval_dataset      = val_dataset,
        tokenizer         = tokenizer,
        data_collator     = data_collator,
        dataset_text_field= "text",
        max_seq_length    = 512,
        packing           = False,   # disable packing (easier with variable length)
    )
    
    print("🚀 Starting training...")
    print(f"   Train batches/epoch : {len(train_dataset) // (4 * 8)}")
    print(f"   Total steps         : "
          f"{len(train_dataset) * 5 // (4 * 8)}")
    
    start_time = time.time()
    
    # Capture baseline loss
    init_eval = trainer.evaluate()
    print(f"\n📊 Pre-training eval loss: {init_eval['eval_loss']:.4f}")
    
    # Train
    train_result = trainer.train()
    
    elapsed = time.time() - start_time
    print(f"\n✅ Training complete in {elapsed/60:.1f} minutes")
    print(f"   Final train loss : {train_result.training_loss:.4f}")
    
    # Save adapter
    trainer.save_model(output_dir)
    tokenizer.save_pretrained(output_dir)
    
    print(f"   Adapter saved to : {output_dir}")
    
    # Final eval
    final_eval = trainer.evaluate()
    print(f"\n📊 Final eval loss: {final_eval['eval_loss']:.4f}")
    print(f"   Improvement     : {init_eval['eval_loss'] - final_eval['eval_loss']:.4f}")
    
    return trainer, train_result


