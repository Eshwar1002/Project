# ── Cell 11: QLoRA Configuration ────────────────────────────

def get_bnb_config() -> BitsAndBytesConfig:
    """4-bit quantization config for T4/L4 compatibility."""
    return BitsAndBytesConfig(
        load_in_4bit=True,
        bnb_4bit_quant_type="nf4",          # NormalFloat4 — better than int4
        bnb_4bit_compute_dtype=torch.bfloat16,  # bf16 compute
        bnb_4bit_use_double_quant=True,     # nested quantization saves ~0.4 GB
    )


def get_lora_config() -> LoraConfig:
    """
    LoRA configuration.
    
    Target modules: We target ALL attention + MLP projection layers.
    This is more aggressive than the default (Q+V only) but gives
    better Sanskrit adaptation since the model needs to learn new
    token patterns throughout.
    
    Rank selection (r=16):
    - r=8:  Less expressive, faster, smaller adapter (~8MB)
    - r=16: Good balance, covers Sanskrit adaptation needs (~16MB)
    - r=64: Higher quality but more memory/time
    
    For T4 with 16GB: r=16 is appropriate.
    """
    return LoraConfig(
        r=16,
        lora_alpha=32,          # scaling = alpha/r = 2.0
        target_modules=[
            "q_proj",
            "k_proj",
            "v_proj",
            "o_proj",
            "gate_proj",
            "up_proj",
            "down_proj",
        ],
        lora_dropout=0.05,
        bias="none",
        task_type=TaskType.CAUSAL_LM,
    )


def get_training_args(output_dir: str = "./sanskrit-lm-adapter") -> TrainingArguments:
    """
    Training arguments optimized for T4 (16GB VRAM).
    
    Key decisions:
    - per_device_train_batch_size=4: T4 can handle this with 4-bit
    - gradient_accumulation_steps=8: Effective batch = 32
    - fp16=True: T4 supports fp16, not bf16 (A100/L4 would use bf16)
    - gradient_checkpointing=True: Saves ~40% memory at cost of ~20% speed
    """
    return TrainingArguments(
        output_dir                  = output_dir,
        num_train_epochs            = 5,        # more epochs for small dataset
        per_device_train_batch_size = 4,
        per_device_eval_batch_size  = 4,
        gradient_accumulation_steps = 8,        # effective batch = 32
        gradient_checkpointing      = True,
        optim                       = "paged_adamw_32bit",  # memory-efficient
        learning_rate               = 2e-4,
        weight_decay                = 0.01,
        fp16                        = True,     # T4: use fp16
        # bf16                      = True,    # L4/A100: switch to bf16
        max_grad_norm               = 0.3,
        warmup_ratio                = 0.03,
        lr_scheduler_type           = "cosine",
        logging_steps               = 10,
        eval_strategy               = "steps",
        eval_steps                  = 50,
        save_strategy               = "steps",
        save_steps                  = 100,
        save_total_limit            = 3,
        load_best_model_at_end      = True,
        report_to                   = "none",   # change to "wandb" if desired
        dataloader_num_workers      = 2,
        remove_unused_columns       = True,
        group_by_length             = True,     # batch similar lengths together
        seed                        = 42,
    )


