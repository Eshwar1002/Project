# ============================================================
# CELL 10: Training
# Expected time: 20-45 min on T4 depending on dataset size
# Watch: Runtime > Session logs for progress
# ============================================================

def run_training(model, tokenizer, train_ds, val_ds, output_dir):
    """Full SFT training run."""
    
    if not MODEL_LOADED:
        print("⚠️  Model not loaded — skipping training")
        return None, None
    
    training_args = get_training_args(output_dir)
    
    # Completion-only collator: ONLY compute loss on ### Response: tokens
    # This is critical — we don't want the model penalized for the prompt
    response_template = "### Response:\n"
    data_collator = DataCollatorForCompletionOnlyLM(
        response_template = response_template,
        tokenizer         = tokenizer,
        mlm               = False,
    )
    
    trainer = SFTTrainer(
        model              = model,
        args               = training_args,
        train_dataset      = train_ds,
        eval_dataset       = val_ds,
        tokenizer          = tokenizer,
        data_collator      = data_collator,
        dataset_text_field = "text",
        max_seq_length     = 512,
        packing            = False,
    )
    
    # Estimate total steps
    steps_per_epoch = len(train_ds) // (4 * 8)
    total_steps     = steps_per_epoch * 5
    print(f"Training configuration:")
    print(f"  Examples/epoch : {len(train_ds)}")
    print(f"  Steps/epoch    : {steps_per_epoch}")
    print(f"  Total steps    : {total_steps}")
