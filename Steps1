def keyword_score(text: str, keywords: List[str]) -> float:
    """Fraction of keywords found in generated text (case-insensitive)."""
    t = text.lower()
    return sum(1 for kw in keywords if kw.lower() in t) / max(len(keywords), 1)


def run_evaluation(asst, suite: List[Dict]) -> Dict:
    """
    Run full evaluation suite.
    Returns structured results with per-example and aggregate metrics.
    """
    if asst is None:
        print("⚠️  No assistant — showing mock results")
        return _mock_results(suite)
    
    results = []
    print("Running evaluation...")
    print("─" * 60)
    
    for ex in suite:
        response = asst.ask(
            ex["instruction"],
            ex.get("input", ""),
            verbose=False,
        )
        kw_score = keyword_score(response, ex.get("keywords", []))
        
        results.append({
            "label"    : ex["label"],
            "task"     : ex["task"],
            "generated": response,
            "kw_score" : kw_score,
            "keywords" : ex.get("keywords", []),
        })
        
        status = "✅" if kw_score >= 0.5 else "⚠️ "
        print(f"{status} {ex['label']:30s}  kw={kw_score:.2f}")
    
    # Aggregate
    overall = np.mean([r["kw_score"] for r in results])
    by_task = {}
    for r in results:
        by_task.setdefault(r["task"], []).append(r["kw_score"])
    
    print(f"\n{'─'*60}")
    print(f"OVERALL keyword score: {overall:.3f}")
    print(f"\nBy task:")
    for task, scores in sorted(by_task.items()):
        print(f"  {task:<20}: {np.mean(scores):.3f}  (n={len(scores)})")
    
    return {
        "overall" : overall,
        "by_task" : {t: np.mean(s) for t, s in by_task.items()},
        "results" : results,
    }


def _mock_results(suite):
    """Mock results for demonstration when model not available."""
    print("(Showing simulated results — run with actual model for real metrics)")
    mock = {
        "san2eng": 0.82, "eng2san": 0.58, "grammar": 0.76,
        "qa": 0.81, "explanation": 0.73, "generalization": 0.55,
    }
    results = []
    for ex in suite:
        score = mock.get(ex["task"], 0.6)
        results.append({
            "label": ex["label"], "task": ex["task"],
            "kw_score": score, "generated": "[model output here]",
        })
    overall = np.mean([r["kw_score"] for r in results])
    print(f"Simulated overall: {overall:.3f}")
    return {"overall": overall, "by_task": mock, "results": results}


