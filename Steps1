# ── Cell 14: Inference Engine ────────────────────────────────

class SanskritInferenceEngine:
    """
    Inference wrapper for the fine-tuned model.
    
    Supports:
    - Single query
    - Batch evaluation
    - Before/after comparison
    """
    
    def __init__(
        self,
        model,
        tokenizer,
        max_new_tokens:  int = 300,
        temperature:     float = 0.3,
        top_p:           float = 0.9,
        repetition_penalty: float = 1.15,
    ):
        self.model     = model
        self.tokenizer = tokenizer
        self.gen_config = GenerationConfig(
            max_new_tokens      = max_new_tokens,
            temperature         = temperature,
            top_p               = top_p,
            repetition_penalty  = repetition_penalty,
            do_sample           = True,
            pad_token_id        = tokenizer.pad_token_id,
            eos_token_id        = tokenizer.eos_token_id,
        )
    
    @torch.no_grad()
    def generate(self, instruction: str, input_text: str = "") -> str:
        """Generate response for a single query."""
        prompt = format_inference_prompt(instruction, input_text)
        
        inputs = self.tokenizer(
            prompt,
            return_tensors = "pt",
            truncation     = True,
            max_length     = 400,
        ).to(DEVICE)
        
        with torch.cuda.amp.autocast(dtype=torch.float16):
            output_ids = self.model.generate(
                **inputs,
                generation_config = self.gen_config,
            )
        
        # Decode only the new tokens (not the prompt)
        new_tokens = output_ids[0][inputs["input_ids"].shape[1]:]
        response   = self.tokenizer.decode(new_tokens, skip_special_tokens=True)
        
        return response.strip()
    
    def generate_batch(
        self,
        examples: List[Dict],
        verbose: bool = True,
    ) -> List[Dict]:
        """Run inference on a batch of test examples."""
        results = []
        
        for i, ex in enumerate(examples):
            if verbose:
                print(f"\n[{i+1}/{len(examples)}] {ex.get('label', 'Example')}")
                print(f"  Instruction: {ex['instruction'][:80]}")
                if ex.get("input"):
                    print(f"  Input      : {ex['input'][:80]}")
            
            response = self.generate(ex["instruction"], ex.get("input", ""))
            
            result = {
                **ex,
                "generated": response,
            }
            results.append(result)
            
            if verbose:
                print(f"  Generated  : {response[:200]}...")
        
        return results


