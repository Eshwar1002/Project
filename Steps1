def compute_keyword_score(generated: str, keywords: List[str]) -> float:
    """
    Simple keyword-based evaluation.
    
    Rationale: For Sanskrit tasks, BLEU is inappropriate because:
    1. Reference answers can be paraphrased in many valid ways
    2. We care about conceptual accuracy, not string match
    3. Keywords capture the essential meaning
    
    We still compute BLEU as a secondary metric.
    """
    gen_lower = generated.lower()
    hits = sum(1 for kw in keywords if kw.lower() in gen_lower)
    return hits / len(keywords) if keywords else 0.0


def evaluate_model(engine: SanskritInferenceEngine, verbose: bool = True) -> Dict:
    """Full evaluation run."""
    results = []
    
    for ex in EVAL_SUITE:
        generated = engine.generate(ex["instruction"], ex.get("input", ""))
        
        keyword_score = compute_keyword_score(
            generated, ex.get("expected_key", [])
        )
        
        results.append({
            "label"        : ex["label"],
            "task"         : ex["task"],
            "instruction"  : ex["instruction"],
            "input"        : ex.get("input", ""),
            "generated"    : generated,
            "expected_key" : ex.get("expected_key", []),
            "keyword_score": keyword_score,
        })
        
        if verbose:
            indicator = "✅" if keyword_score >= 0.5 else "⚠️ "
            print(f"{indicator} [{ex['label']:30s}] "
                  f"keyword_score={keyword_score:.2f}")
    
    # Aggregate metrics
    task_scores = {}
    for r in results:
        t = r["task"]
        if t not in task_scores:
            task_scores[t] = []
        task_scores[t].append(r["keyword_score"])
    
    summary = {
        "overall"    : np.mean([r["keyword_score"] for r in results]),
        "by_task"    : {t: np.mean(s) for t, s in task_scores.items()},
        "per_example": results,
    }
    
    return summary
