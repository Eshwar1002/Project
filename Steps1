# ── Cell 17: Quantitative Metrics ───────────────────────────

def compute_bleu(predictions: List[str], references: List[str]) -> float:
    """Compute corpus BLEU score."""
    if not predictions:
        return 0.0
    
    # sacrebleu expects list of reference lists
    result = sacrebleu.corpus_bleu(
        predictions,
        [references],
        tokenize="intl",
    )
    return result.score


def compute_rouge(predictions: List[str], references: List[str]) -> Dict:
    """Compute ROUGE-1, ROUGE-2, ROUGE-L scores."""
    scorer  = rouge_scorer.RougeScorer(["rouge1", "rouge2", "rougeL"])
    scores  = {"rouge1": [], "rouge2": [], "rougeL": []}
    
    for pred, ref in zip(predictions, references):
        s = scorer.score(ref, pred)
        for key in scores:
            scores[key].append(s[key].fmeasure)
    
    return {k: np.mean(v) for k, v in scores.items()}


def compute_hallucination_rate(results: List[Dict]) -> float:
    """
    Estimate hallucination: responses with no keyword hits AND
    contain confident-sounding language.
    
    This is a heuristic — proper hallucination detection would need
    a separate fact-checking model.
    """
    confident_phrases = [
        "definitely", "certainly", "absolutely", "i know that",
        "it is clear", "the answer is", "this translates to",
    ]
    
    hallucination_count = 0
    for r in results:
        gen = r.get("generated", "").lower()
        # Low keyword match + confident language = potential hallucination
        if (r.get("keyword_score", 0) < 0.33 and 
            any(p in gen for p in confident_phrases)):
            hallucination_count += 1
    
    return hallucination_count / len(results) if results else 0.0


